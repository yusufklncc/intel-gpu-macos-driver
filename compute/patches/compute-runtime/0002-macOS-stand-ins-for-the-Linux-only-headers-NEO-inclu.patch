+// SPDX-License-Identifier: MIT
+
+// macOS stand-in for <linux/limits.h>: PATH_MAX and friends come from <limits.h> (<sys/syslimits.h>).
+#pragma once
+#include <limits.h>
diff --git a/shared/source/os_interface/macos/include/linux/perf_event.h b/shared/source/os_interface/macos/include/linux/perf_event.h
new file mode 100644
index 0000000000..300dcd49ed
--- /dev/null
+++ b/shared/source/os_interface/macos/include/linux/perf_event.h
@@ -0,0 +1,26 @@
+// SPDX-License-Identifier: MIT
+
+// macOS stand-in for <linux/perf_event.h>, for sysman's PMU readers (engine utilization, RAS counters). There is no
+// perf_event_open(2): the readers find no "xe" event source (/sys/bus/event_source/devices/xe/type) and stop before
+// opening one, and PmuInterfaceImp::perfEventOpen fails with ENOSYS on macOS. The layout follows Linux's first 64 bytes.
+#pragma once
+#include <stdint.h>
+
+#define PERF_FORMAT_TOTAL_TIME_ENABLED (1U << 0)
+#define PERF_FORMAT_TOTAL_TIME_RUNNING (1U << 1)
+#define PERF_FORMAT_ID (1U << 2)
+#define PERF_FORMAT_GROUP (1U << 3)
+
+struct perf_event_attr {
+    uint32_t type;
+    uint32_t size;
+    uint64_t config;
+    uint64_t sample_period;
+    uint64_t sample_type;
+    uint64_t read_format;
+    uint64_t flags;
+    uint32_t wakeup_events;
+    uint32_t bp_type;
+    uint64_t config1;
+    uint64_t config2;
+};
diff --git a/shared/source/os_interface/macos/include/linux/types.h b/shared/source/os_interface/macos/include/linux/types.h
new file mode 100644
index 0000000000..17ec9245ac
--- /dev/null
+++ b/shared/source/os_interface/macos/include/linux/types.h
@@ -0,0 +1,21 @@
+// SPDX-License-Identifier: MIT
+
+// macOS stand-in for <linux/types.h>: the fixed-width kernel types the DRM uAPI headers use. drm.h defines the same
+// typedefs itself on non-Linux systems; repeating an identical typedef is allowed in C11 and C++.
+#pragma once
+#include <stdint.h>
+typedef int8_t __s8;
+typedef uint8_t __u8;
+typedef int16_t __s16;
+typedef uint16_t __u16;
+typedef int32_t __s32;
+typedef uint32_t __u32;
+typedef int64_t __s64;
+typedef uint64_t __u64;
+typedef uint16_t __le16;
+typedef uint32_t __le32;
+typedef uint64_t __le64;
+typedef uint16_t __be16;
+typedef uint32_t __be32;
+typedef uint64_t __be64;
+typedef uint64_t __aligned_u64 __attribute__((aligned(8)));
diff --git a/shared/source/os_interface/macos/include/mtd/mtd-user.h b/shared/source/os_interface/macos/include/mtd/mtd-user.h
new file mode 100644
index 0000000000..9d12ff2a59
--- /dev/null
+++ b/shared/source/os_interface/macos/include/mtd/mtd-user.h
@@ -0,0 +1,15 @@
+// SPDX-License-Identifier: MIT
+
+// macOS stand-in for <mtd/mtd-user.h> (Linux's memory technology device ioctls), for sysman's firmware flash path.
+// There are no MTD nodes on macOS: the open of /dev/mtd* fails before MEMERASE could be issued.
+#pragma once
+#include <stdint.h>
+#include <sys/ioccom.h>
+
+struct erase_info_user {
+    uint32_t start;
+    uint32_t length;
+};
+typedef struct erase_info_user erase_info_t;
+
+#define MEMERASE _IOW('M', 2, struct erase_info_user)
diff --git a/shared/source/os_interface/macos/include/sys/prctl.h b/shared/source/os_interface/macos/include/sys/prctl.h
new file mode 100644
index 0000000000..a81a188cf0
--- /dev/null
+++ b/shared/source/os_interface/macos/include/sys/prctl.h
@@ -0,0 +1,7 @@
+// SPDX-License-Identifier: MIT
+
+// macOS stand-in for <sys/prctl.h>. There is no prctl(2): the one caller (Yama's PR_SET_PTRACER, which lets another
+// process take this one's fds with pidfd_getfd for IPC handles) gets -1/ENOSYS from SysCalls::prctl and goes on.
+#pragma once
+#define PR_SET_PTRACER 0x59616d61
+#define PR_SET_PTRACER_ANY ((unsigned long)-1)
diff --git a/shared/source/os_interface/macos/include/sys/socket.h b/shared/source/os_interface/macos/include/sys/socket.h
new file mode 100644
index 0000000000..61010c26cd
--- /dev/null
+++ b/shared/source/os_interface/macos/include/sys/socket.h
@@ -0,0 +1,10 @@
+// SPDX-License-Identifier: MIT
+
+// <sys/socket.h> plus Linux's SOCK_CLOEXEC, which macOS lacks. The flag is a bit no macOS socket type uses;
+// SysCalls::socket (sys_calls_macos.cpp) strips it and sets FD_CLOEXEC on the new socket instead.
+#pragma once
+#include_next <sys/socket.h>
+#ifndef SOCK_CLOEXEC
+#define SOCK_CLOEXEC 0x10000000
+#define NEO_MACOS_SOCK_CLOEXEC_EMULATED 1
+#endif
diff --git a/shared/source/os_interface/macos/include/sys/sysinfo.h b/shared/source/os_interface/macos/include/sys/sysinfo.h
new file mode 100644
index 0000000000..19515a9f76
--- /dev/null
+++ b/shared/source/os_interface/macos/include/sys/sysinfo.h
@@ -0,0 +1,8 @@
+// SPDX-License-Identifier: MIT
+
+// macOS stand-in for glibc's <sys/sysinfo.h>: the processor counts sysman's PMU code asks for.
+#pragma once
+#include <unistd.h>
+
+static inline int get_nprocs_conf(void) { return (int)sysconf(_SC_NPROCESSORS_CONF); }
+static inline int get_nprocs(void) { return (int)sysconf(_SC_NPROCESSORS_ONLN); }
diff --git a/shared/source/os_interface/macos/include/sys/sysmacros.h b/shared/source/os_interface/macos/include/sys/sysmacros.h
new file mode 100644
index 0000000000..68bfd01323
--- /dev/null
+++ b/shared/source/os_interface/macos/include/sys/sysmacros.h
@@ -0,0 +1,5 @@
+// SPDX-License-Identifier: MIT
+
+// macOS stand-in for <sys/sysmacros.h>: major() and minor() are in <sys/types.h>.
+#pragma once
+#include <sys/types.h>
