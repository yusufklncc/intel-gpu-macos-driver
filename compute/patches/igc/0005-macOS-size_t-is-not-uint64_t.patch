Date: Thu, 12 Nov 2026 18:01:15 +0300
Subject: [PATCH 5/5] macOS: size_t is not uint64_t

On x86_64 Linux size_t and uint64_t are both unsigned long; on macOS
uint64_t is unsigned long long, a distinct type of the same width.
Code that relies on them being one type does not compile there:

- MDFrameWork: the metadata of size_t fields (allocSize, ...) found no
  CreateNode/readNode overload (int, unsigned, uint64_t are ambiguous
  for unsigned long): size_t overloads that forward to uint64_t
- OCLRuntimeInfoPrinter (VC): LLVM's YAML traits have no unsigned long:
  one that forwards to uint64_t's
- EstimateFunctionSize: ScaledNumber<uint64_t>::toInt<size_t> compares
  ambiguously; toInt<uint64_t>
- Stats: %ju/%jd/%#jx for uint64_t (uintmax_t is unsigned long on both,
  so it matched on Linux only): PRIu64/PRId64/PRIx64

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../CISACodeGen/EstimateFunctionSize.cpp      |  2 +-
 .../lib/GenXCodeGen/OCLRuntimeInfoPrinter.cpp | 17 +++++++++++++
 IGC/common/MDFrameWork.cpp                    | 13 ++++++++++
 IGC/common/Stats.cpp                          | 25 ++++++++++---------
 4 files changed, 44 insertions(+), 13 deletions(-)

diff --git a/IGC/Compiler/CISACodeGen/EstimateFunctionSize.cpp b/IGC/Compiler/CISACodeGen/EstimateFunctionSize.cpp
index cccb53822..eaed1963f 100644
--- a/IGC/Compiler/CISACodeGen/EstimateFunctionSize.cpp
+++ b/IGC/Compiler/CISACodeGen/EstimateFunctionSize.cpp
@@ -878,7 +878,7 @@ size_t EstimateFunctionSize::estimateSizeWithLoopIteration(llvm::Function &F, Lo
     size_t BlkSize = IGCLLVM::sizeWithoutDebug(&BB);
     if (Loop *L = LI->getLoopFor(&BB)) {
       IGC_ASSERT(LoopIterCnts.count(L));
-      BlkSize *= LoopIterCnts[L].toInt<size_t>();
+      BlkSize *= LoopIterCnts[L].toInt<uint64_t>(); // uint64_t: ScaledNumber compares with it (size_t is another type on macOS)
     }
     Size += BlkSize;
   }
diff --git a/IGC/VectorCompiler/lib/GenXCodeGen/OCLRuntimeInfoPrinter.cpp b/IGC/VectorCompiler/lib/GenXCodeGen/OCLRuntimeInfoPrinter.cpp
index 86fee9447..d264e2458 100644
--- a/IGC/VectorCompiler/lib/GenXCodeGen/OCLRuntimeInfoPrinter.cpp
+++ b/IGC/VectorCompiler/lib/GenXCodeGen/OCLRuntimeInfoPrinter.cpp
@@ -29,6 +29,23 @@ using ModuleInfoT = GenXOCLRuntimeInfo::ModuleInfoT;
 using SectionInfo = GenXOCLRuntimeInfo::SectionInfo;
 using DataInfo = GenXOCLRuntimeInfo::DataInfo;
 
+#if defined(__APPLE__)
+// DataInfo::AdditionalZeroedSpace is a std::size_t: unsigned long on macOS, where uint64_t is unsigned long long and
+// LLVM's YAML scalar traits cover only the fixed-width types. Linux's size_t is uint64_t's type.
+template <> struct yaml::ScalarTraits<unsigned long> {
+  static void output(const unsigned long &Val, void *Ctx, raw_ostream &OS) {
+    ScalarTraits<uint64_t>::output(Val, Ctx, OS);
+  }
+  static StringRef input(StringRef Scalar, void *Ctx, unsigned long &Val) {
+    uint64_t V = 0;
+    StringRef Err = ScalarTraits<uint64_t>::input(Scalar, Ctx, V);
+    Val = V;
+    return Err;
+  }
+  static QuotingType mustQuote(StringRef S) { return ScalarTraits<uint64_t>::mustQuote(S); }
+};
+#endif
+
 LLVM_YAML_IS_SEQUENCE_VECTOR(vISA::ZESymEntry)
 LLVM_YAML_IS_SEQUENCE_VECTOR(vISA::ZERelocEntry)
 
diff --git a/IGC/common/MDFrameWork.cpp b/IGC/common/MDFrameWork.cpp
index b37505e4b..eabc1a065 100644
--- a/IGC/common/MDFrameWork.cpp
+++ b/IGC/common/MDFrameWork.cpp
@@ -59,6 +59,19 @@ template <typename T, size_t s> void readNode(std::array<T, s> &arr, MDNode *nod
 template <typename T> void readNode(std::optional<T> &option, MDNode *node);
 void readNode(Function *&funcPtr, MDNode *node);
 void readNode(GlobalVariable *&globalVar, MDNode *node);
+
+#if defined(__APPLE__)
+// size_t fields (unsigned long on macOS) are not uint64_t (unsigned long long there) as on Linux: same width, so they
+// are written and read as uint64_t
+MDNode *CreateNode(unsigned long i, Module *module, StringRef name) {
+  return CreateNode(static_cast<uint64_t>(i), module, name);
+}
+void readNode(unsigned long &x, MDNode *node) {
+  uint64_t v = 0;
+  readNode(v, node);
+  x = static_cast<unsigned long>(v);
+}
+#endif
 void readNode(Type *&Ty, MDNode *node);
 void readNode(StructType *&Ty, MDNode *node);
 
