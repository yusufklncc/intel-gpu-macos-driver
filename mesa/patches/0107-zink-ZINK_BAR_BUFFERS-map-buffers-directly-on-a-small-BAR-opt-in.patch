From: IntelXe (Claude Opus 5.5)
Subject: zink: ZINK_BAR_BUFFERS, map buffers directly on a small BAR (opt-in)

Without a resizable BAR, zink flags every buffer of 8 KiB or more
PIPE_RESOURCE_FLAG_DONT_MAP_DIRECTLY, so each glBufferSubData, orphaning
glBufferData and INVALIDATE map becomes a staging buffer plus a GPU copy
(on Intel Xe2 a blorp 3D draw with its flushes, often ending the render
pass). That keeps VRAM buffers out of the CPU window, but it also applies
to buffers placed in host memory, where it only adds GPU work.

ZINK_BAR_BUFFERS=sysmem maps those host-memory buffers directly;
ZINK_BAR_BUFFERS=all maps every buffer as on a resizable-BAR device.
EXT_host_image_copy stays off on a small BAR either way. Unset, nothing
changes.
---
 src/gallium/drivers/zink/zink_resource.c | 11 ++++++++++-
 src/gallium/drivers/zink/zink_screen.c   | 10 ++++++++++
 src/gallium/drivers/zink/zink_types.h    |  9 +++++++++
 3 files changed, 29 insertions(+), 1 deletion(-)

diff --git a/src/gallium/drivers/zink/zink_resource.c b/src/gallium/drivers/zink/zink_resource.c
index 78746d947f7..bd414ef3dcc 100644
--- a/src/gallium/drivers/zink/zink_resource.c
+++ b/src/gallium/drivers/zink/zink_resource.c
@@ -2065,7 +2065,16 @@ resource_create(struct pipe_screen *pscreen,
    if (templ->target == PIPE_BUFFER) {
       util_range_init(&res->valid_buffer_range);
       res->base.b.bind |= PIPE_BIND_SHADER_IMAGE;
-      if (!screen->resizable_bar && templ->width0 >= 8196) {
+      /* ZINK_BAR_BUFFERS (opt-in): host-memory buffers have no VRAM to be evicted from, so a copy
+       * only adds GPU work ("sysmem"); "all" maps every buffer, as with a resizable BAR
+       */
+      const bool in_host_memory = res->obj->bo &&
+         !(screen->info.mem_props.memoryTypes[res->obj->bo->base.placement].propertyFlags &
+           VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+      const bool map_directly = screen->resizable_bar ||
+         screen->bar_buffers == ZINK_BAR_BUFFERS_ALL ||
+         (screen->bar_buffers == ZINK_BAR_BUFFERS_SYSMEM && in_host_memory);
+      if (!map_directly && templ->width0 >= 8196) {
          /* We don't want to evict buffers from VRAM by mapping them for CPU access,
           * because they might never be moved back again. If a buffer is large enough,
           * upload data by copying from a temporary GTT buffer. 8K might not seem much,
diff --git a/src/gallium/drivers/zink/zink_screen.c b/src/gallium/drivers/zink/zink_screen.c
index a1821b174db..2e4c76646a9 100644
--- a/src/gallium/drivers/zink/zink_screen.c
+++ b/src/gallium/drivers/zink/zink_screen.c
@@ -3813,6 +3813,16 @@ zink_internal_create_screen(const struct pipe_screen_config *config, int64_t dev
       if (biggest_vis_vram > biggest_vram * 0.9)
          screen->resizable_bar = true;
    }
+   if (!screen->resizable_bar) {
+      /* opt-in: on a small BAR, buffer writes of 8 KiB and more are GPU copies from a staging buffer
+       * (zink_resource_create); "sysmem" maps the buffers that live in host memory directly, "all" every buffer
+       */
+      const char *bar_buffers = debug_get_option("ZINK_BAR_BUFFERS", NULL);
+      if (bar_buffers && !strcmp(bar_buffers, "all"))
+         screen->bar_buffers = ZINK_BAR_BUFFERS_ALL;
+      else if (bar_buffers && !strcmp(bar_buffers, "sysmem"))
+         screen->bar_buffers = ZINK_BAR_BUFFERS_SYSMEM;
+   }
 
    setup_renderdoc(screen);
    if (screen->threaded_submit && !util_queue_init(&screen->flush_queue, "zfq", 8, 1, UTIL_QUEUE_INIT_RESIZE_IF_FULL, screen)) {
diff --git a/src/gallium/drivers/zink/zink_types.h b/src/gallium/drivers/zink/zink_types.h
index a7134bfa3a0..8112d046c7d 100644
--- a/src/gallium/drivers/zink/zink_types.h
+++ b/src/gallium/drivers/zink/zink_types.h
@@ -1545,6 +1545,15 @@ struct zink_screen {
    uint8_t heap_map[ZINK_HEAP_MAX][VK_MAX_MEMORY_TYPES];  // mapping from zink heaps to memory type indices
    uint8_t heap_count[ZINK_HEAP_MAX];  // number of memory types per zink heap
    bool resizable_bar;
+   /* ZINK_BAR_BUFFERS: on a small BAR, which buffers of 8 KiB and more are still mapped directly instead of
+    * through a staging copy: ZINK_BAR_BUFFERS_SYSMEM those in host memory, ZINK_BAR_BUFFERS_ALL every one
+    * (as with a resizable BAR; host_image_copy stays off)
+    */
+   enum {
+      ZINK_BAR_BUFFERS_STAGED = 0,
+      ZINK_BAR_BUFFERS_SYSMEM,
+      ZINK_BAR_BUFFERS_ALL,
+   } bar_buffers;
    bool vis_vram_full;
 
    uint64_t total_video_mem;
