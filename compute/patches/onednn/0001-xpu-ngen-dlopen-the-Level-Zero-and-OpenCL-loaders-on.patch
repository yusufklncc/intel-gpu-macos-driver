From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: intelxe-build <build@localhost>
Date: Fri, 13 Nov 2026 20:51:26 +0300
Subject: [PATCH] xpu, ngen: dlopen the Level Zero and OpenCL loaders on macOS

The run-time symbol lookup (xpu::find_symbol) and the Level Zero utils
only had Windows and Linux branches, and nGEN names the loaders
libze_loader.so.1 and libOpenCL.so.1 outside Windows. macOS has dlopen
too; the loaders are libze_loader.1.dylib and libOpenCL.1.dylib (the
Khronos ICD loader). Without nGEN's name every nGEN kernel failed with
ZE_RESULT_ERROR_UNINITIALIZED (its symbol lookup found no library).
---
 src/xpu/ocl/utils.hpp                | 2 ++
 src/xpu/utils.cpp                    | 4 ++--
 src/xpu/ze/utils.hpp                 | 4 +++-
 third_party/ngen/ngen_level_zero.hpp | 2 ++
 third_party/ngen/ngen_opencl.hpp     | 2 ++
 5 files changed, 11 insertions(+), 3 deletions(-)

diff --git a/src/xpu/ocl/utils.hpp b/src/xpu/ocl/utils.hpp
index 59b92c5..6e4a0c7 100644
--- a/src/xpu/ocl/utils.hpp
+++ b/src/xpu/ocl/utils.hpp
@@ -80,6 +80,8 @@ const char *convert_cl_int_to_str(cl_int cl_status);
 #define OCL_LIB_NAME "OpenCL.dll"
 #elif defined(__linux__)
 #define OCL_LIB_NAME "libOpenCL.so.1"
+#elif defined(__APPLE__)
+#define OCL_LIB_NAME "libOpenCL.1.dylib"
 #endif
 
 template <typename F>
diff --git a/src/xpu/utils.cpp b/src/xpu/utils.cpp
index 2fb0af1..4a4e1f7 100644
--- a/src/xpu/utils.cpp
+++ b/src/xpu/utils.cpp
@@ -21,7 +21,7 @@
 #define NOMINMAX
 #endif
 #include "windows.h"
-#elif defined(__linux__)
+#elif defined(__linux__) || defined(__APPLE__)
 #include <dlfcn.h>
 #endif
 
@@ -74,7 +74,7 @@ void *find_symbol(const char *library_name, const char *symbol) {
         return nullptr;
     }
     return symbol_address;
-#elif defined(__linux__)
+#elif defined(__linux__) || defined(__APPLE__)
     // To clean the error string
     dlerror();
     void *handle = dlopen(library_name, RTLD_NOW | RTLD_LOCAL);
diff --git a/src/xpu/ze/utils.hpp b/src/xpu/ze/utils.hpp
index 4e4e0f8..7a00857 100644
--- a/src/xpu/ze/utils.hpp
+++ b/src/xpu/ze/utils.hpp
@@ -17,7 +17,7 @@
 #ifndef XPU_ZE_UTILS_HPP
 #define XPU_ZE_UTILS_HPP
 
-#if defined(__linux__)
+#if defined(__linux__) || defined(__APPLE__)
 #include <dlfcn.h>
 #elif defined(_WIN32)
 #include "windows.h"
@@ -116,6 +116,8 @@ ze_result_t ze_initialize();
 #define ZE_LIB_NAME "ze_loader.dll"
 #elif defined(__linux__)
 #define ZE_LIB_NAME "libze_loader.so.1"
+#elif defined(__APPLE__)
+#define ZE_LIB_NAME "libze_loader.1.dylib"
 #endif
 
 template <typename F>
diff --git a/third_party/ngen/ngen_level_zero.hpp b/third_party/ngen/ngen_level_zero.hpp
index af5aca2..e6ff77d 100644
--- a/third_party/ngen/ngen_level_zero.hpp
+++ b/third_party/ngen/ngen_level_zero.hpp
@@ -60,6 +60,8 @@ namespace dynamic {
 
 #ifdef _WIN32
 #define NGEN_L0_LIB "ze_loader.dll"
+#elif defined(__APPLE__)
+#define NGEN_L0_LIB "libze_loader.1.dylib"
 #else
 #define NGEN_L0_LIB "libze_loader.so.1"
 #endif
diff --git a/third_party/ngen/ngen_opencl.hpp b/third_party/ngen/ngen_opencl.hpp
index bc27b11..4377de3 100644
--- a/third_party/ngen/ngen_opencl.hpp
+++ b/third_party/ngen/ngen_opencl.hpp
@@ -59,6 +59,8 @@ namespace dynamic {
 
 #ifdef _WIN32
 #define NGEN_OCL_LIB "OpenCL.dll"
+#elif defined(__APPLE__)
+#define NGEN_OCL_LIB "libOpenCL.1.dylib"
 #else
 #define NGEN_OCL_LIB "libOpenCL.so.1"
 #endif
-- 
