 }
 
+/* A decode must never be able to corrupt the driver or stop a client: the
+ * codec paths below index arrays by slotIndex (H.265 dpb_idx, H.264
+ * dpb_slots, AV1 prev_refs) and by the reference number, and look VP9
+ * reference names up among the reference slots. A slotIndex at or above the
+ * session's maxDpbSlots is invalid usage, but clients do it: FFmpeg's H.264
+ * and H.265 hwaccels up to 9.0 number slots by their own DPB array index (16
+ * on H.265 streams with a 16-picture DPB, 19 on some H.264 streams), and
+ * with asserts off ANV wrote past its stack arrays (__stack_chk_fail).
+ * Refusing such a decode (an error on the command buffer) is no better: the
+ * client's submission never happens, and FFmpeg 9.0.2 then waits forever on
+ * the execution's fence it had already reset.
+ *
+ * H.264 and H.265 use slot indices only as keys (pictures are addressed
+ * through each reference's picture resource), so their key tables take any
+ * index below ANV_VIDEO_DECODE_SLOT_KEYS and such a stream decodes as the
+ * client meant. What still cannot be honoured is recorded without it: a
+ * reference whose index is beyond the codec's table, or past the number of
+ * references the codec path holds, is left out (decoded as a missing
+ * reference); a VP9 inter frame whose reference names are not all bound is
+ * not decoded. Either way the command buffer ends with VK_SUCCESS and the
+ * submission signals its semaphores and fence.
+ */
+#define ANV_VIDEO_DECODE_MAX_REFS 32
+
+static bool
+anv_video_decode_sanitize(const struct anv_video_session *vid,
+                          const VkVideoDecodeInfoKHR *in,
+                          VkVideoDecodeInfoKHR *out,
+                          VkVideoReferenceSlotInfoKHR *refs)
+{
+   uint32_t keys = UINT32_MAX, max_refs = ANV_VIDEO_DECODE_MAX_REFS;
+
+   switch (vid->vk.op) {
+   case VK_VIDEO_CODEC_OPERATION_DECODE_H264_BIT_KHR:
+      keys = ANV_VIDEO_DECODE_SLOT_KEYS;
+      max_refs = ANV_VIDEO_H264_MAX_NUM_REF_FRAME;
+      break;
+   case VK_VIDEO_CODEC_OPERATION_DECODE_H265_BIT_KHR:
+      keys = ANV_VIDEO_DECODE_SLOT_KEYS;
+      /* the HuC S2L parameters hold 15 (PicOrderCntValList): a 16-picture
+       * DPB has at most 15 references beside the current picture */
+      max_refs = ANV_VIDEO_H265_MAX_NUM_REF_FRAME - 1;
+      break;
+   case VK_VIDEO_CODEC_OPERATION_DECODE_AV1_BIT_KHR:
+      keys = ANV_VIDEO_AV1_MAX_DPB_SLOTS;
+      break;
+   default:
+      break;
+   }
+
+   *out = *in;
+   uint32_t n = 0;
+   bool dropped = false, over = false;
+   for (uint32_t i = 0; i < in->referenceSlotCount; i++) {
+      const int32_t slot = in->pReferenceSlots[i].slotIndex;
+      if (slot >= 0 && (uint32_t)slot >= vid->vk.max_dpb_slots)
+         over = true;
+      if ((slot >= 0 && (uint32_t)slot >= keys) || n == max_refs) {
+         dropped = true;
+         continue;
+      }
+      refs[n++] = in->pReferenceSlots[i];
+   }
+   out->referenceSlotCount = n;
+   out->pReferenceSlots = n ? refs : NULL;
+
+   if (over || dropped ||
+       (in->pSetupReferenceSlot &&
+        in->pSetupReferenceSlot->slotIndex >= (int32_t)vid->vk.max_dpb_slots)) {
+      mesa_logw_once("anv: vkCmdDecodeVideoKHR: a DPB slot index at or above the "
+                     "session's maxDpbSlots (%u)%s", vid->vk.max_dpb_slots,
+                     dropped ? "; references the decoder cannot hold left out" :
+                               "; used as a key");
+   }
+
+   /* VP9 looks each reference name up among the reference slots; a name that
+    * is not there gave index 0xff and a read past pReferenceSlots.
+    */
+   if (vid->vk.op == VK_VIDEO_CODEC_OPERATION_DECODE_VP9_BIT_KHR) {
+      const struct VkVideoDecodeVP9PictureInfoKHR *vp9_pic_info =
+         vk_find_struct_const(out->pNext, VIDEO_DECODE_VP9_PICTURE_INFO_KHR);
+      const StdVideoDecodeVP9PictureInfo *std_pic = vp9_pic_info->pStdPictureInfo;
+
+      if (!std_pic->flags.intra_only &&
+          std_pic->frame_type != STD_VIDEO_VP9_FRAME_TYPE_KEY) {
+         for (unsigned i = 0; i < 3; i++) {
+            if (anv_vp9_get_ref_idx(out, vp9_pic_info->referenceNameSlotIndices[i]) == 0xff) {
+               mesa_logw_once("anv: vkCmdDecodeVideoKHR: a VP9 reference name "
+                              "without a reference slot; frame not decoded");
+               return false;
+            }
+         }
+      }
+   }
+
+   return true;
+}
+
 void
 genX(CmdDecodeVideoKHR)(VkCommandBuffer commandBuffer,
                         const VkVideoDecodeInfoKHR *frame_info)
@@ -3709,6 +3817,13 @@ genX(CmdDecodeVideoKHR)(VkCommandBuffer commandBuffer,
    if (anv_batch_has_error(&cmd_buffer->batch))
       return;
 
+   VkVideoReferenceSlotInfoKHR refs[ANV_VIDEO_DECODE_MAX_REFS];
+   VkVideoDecodeInfoKHR sanitized;
+   if (!anv_video_decode_sanitize(cmd_buffer->video.vid, frame_info,
+                                  &sanitized, refs))
+      return;
+   frame_info = &sanitized;
+
    const VkVideoInlineQueryInfoKHR *inline_query =
       vk_find_struct_const(frame_info->pNext, VIDEO_INLINE_QUERY_INFO_KHR);
 
