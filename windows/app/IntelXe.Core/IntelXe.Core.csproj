<!-- The models and rules of the Windows app: plain .NET, no Windows APIs, so that its tests run on macOS and Linux too. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>IntelXe.Core</RootNamespace>
    <!-- the EFI engine, taken from windows/IntelXe-EFI.ps1 at build time (ExtractEfiEngine below) -->
    <EfiScript>$(RepoRoot)windows/IntelXe-EFI.ps1</EfiScript>
  </PropertyGroup>
  <ItemGroup>
    <!-- the one list of supported cards (tools/parity/devices.py checks every copy against it) -->
    <EmbeddedResource Include="$(RepoRoot)data/platforms.json" LogicalName="IntelXe.Core.platforms.json" Link="data/platforms.json" />
    <!-- the EFI rules: the same file efi.sh and IntelXe-EFI.ps1 read (release/release.sh checks the shipped copies) -->
    <EmbeddedResource Include="$(RepoRoot)release/templates/efi-rules.json" LogicalName="IntelXe.Core.efi-rules.json" Link="data/efi-rules.json" />
  </ItemGroup>

  <!-- The C# engine of IntelXe-EFI.ps1 (between "// BEGIN ENGINE" and "// END ENGINE": Rules, EfiFolder, Plist, Aml,
       namespace IntelXeEfi) is compiled into the Core as it is, so that the script and the app run one engine. It stays
       C# 5 inside the script, which Windows PowerShell 5.1 compiles with Add-Type; the script stays one file. -->
  <UsingTask TaskName="IntelXeExtractEngine" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Script ParameterType="System.String" Required="true" />
      <Output ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        string text = System.IO.File.ReadAllText(Script).Replace("\r\n", "\n");
        const string begin = "// BEGIN ENGINE\n", end = "// END ENGINE";
        int b = text.IndexOf(begin, System.StringComparison.Ordinal);
        int e = b < 0 ? -1 : text.IndexOf(end, b, System.StringComparison.Ordinal);
        if (b < 0 || e < 0 || text.IndexOf(begin, e, System.StringComparison.Ordinal) >= 0)
        {
            Log.LogError("{0}: no single '// BEGIN ENGINE' ... '// END ENGINE' block", Script);
            return false;
        }
        string source = "// <auto-generated>\n// The engine of windows/IntelXe-EFI.ps1, copied from the script at build time: edit it there.\n// </auto-generated>\n#pragma warning disable\n"
            + text.Substring(b + begin.Length, e - b - begin.Length);
        if (!System.IO.File.Exists(Output) || System.IO.File.ReadAllText(Output) != source)
        {
            System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(Output));
            System.IO.File.WriteAllText(Output, source, new System.Text.UTF8Encoding(false));
        }
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="ExtractEfiEngine" BeforeTargets="CoreCompile;BeforeBuild">
    <PropertyGroup>
      <EfiEngineSource>$(IntermediateOutputPath)IntelXeEfiEngine.g.cs</EfiEngineSource>
    </PropertyGroup>
    <IntelXeExtractEngine Script="$(EfiScript)" Output="$(EfiEngineSource)" />
    <ItemGroup>
      <Compile Include="$(EfiEngineSource)" />
      <FileWrites Include="$(EfiEngineSource)" />
    </ItemGroup>
  </Target>
</Project>
