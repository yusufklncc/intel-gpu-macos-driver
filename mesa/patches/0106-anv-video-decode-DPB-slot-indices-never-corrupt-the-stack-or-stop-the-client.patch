    vk_video_get_h264_parameters(&vid->vk, params, frame_info, h264_pic_info, &sps, &pps);
 
-   uint8_t dpb_slots[ANV_VIDEO_H264_MAX_DPB_SLOTS] = { 0,};
+   /* indexed by slotIndex: a key below ANV_VIDEO_DECODE_SLOT_KEYS (see
