+// Whether this process may set the GPU frequency range: root and a kext with live range control (xemac_freq_can_set).
+bool canSetRange() {
+    int fd = -1;
+    {
+        std::lock_guard<std::mutex> l(state().lock);
+        if (!state().deviceFds.empty()) {
+            fd = *state().deviceFds.begin();
+        }
+    }
+    return xemac_freq_can_set(fd) == 1;
+}
+
+// min_freq / max_freq written: a number of MHz as xe's min_freq_store takes it (kstrtou32, base 0), then the kext's
+// slpc_min / slpc_max (xemac_freq_set). EINVAL for anything else (sysman's -1 "defaults": Linux answers EINVAL too).
+std::function<int(const std::string &)> freqWriter(int which) {
+    return [which](const std::string &in) {
+        std::string v = in;
+        while (!v.empty() && (v.back() == '\n' || v.back() == ' ')) {
+            v.pop_back();
+        }
+        char *end = nullptr;
+        errno = 0;
+        const unsigned long long mhz = std::strtoull(v.c_str(), &end, 0);
+        if (v.empty() || v[0] == '-' || errno || !end || *end || mhz > 0xffffffffull) {
+            return EINVAL;
+        }
+        int fd = -1;
+        {
+            std::lock_guard<std::mutex> l(state().lock);
+            if (!state().deviceFds.empty()) {
+                fd = *state().deviceFds.begin();
+            }
+        }
+        return xemac_freq_set(fd, which, static_cast<uint32_t>(mhz)) == 0 ? 0 : errno;
+    };
+}
