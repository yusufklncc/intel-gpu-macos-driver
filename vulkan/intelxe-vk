#!/bin/bash
# SPDX-License-Identifier: MIT
# intelxe-vk: native Vulkan for games on the Intel Arc card, EXPERIMENTAL (not yet tested with Wine on the hardware).
# Wine's DXVK (D3D8-11) and vkd3d-proton (D3D12) reach ANV directly instead of MoltenVK -> Metal -> the Metal driver ->
# ANV. Nothing here downloads anything unless you run "fetch"; nothing changes a Wine prefix unless you run
# "prefix-install", which keeps the prefix's own DLLs for "prefix-restore".
#
#   intelxe-vk check [WINE]          what is installed; which Vulkan library a Wine build opens (WINE: Wine.app, a
#                                    Wine folder or its bin/wine; default: the Wine builds it finds) and how to run it;
#                                    the prefixes set up with prefix-install
#   intelxe-vk run [--loader] CMD... run CMD (wine game.exe, a launcher, a Vulkan program) on ANV, this process only:
#                                    DYLD_LIBRARY_PATH puts the provider first under the names libMoltenVK.dylib and
#                                    libvulkan.1.dylib; --loader puts the Khronos loader there instead, with ANV's
#                                    manifest in VK_DRIVER_FILES (needs /usr/local/lib/libvulkan.1.dylib, from zink-gl)
#   intelxe-vk fetch [--from FILE]   download DXVK and vkd3d-proton (pinned versions, sha256 checked) into the cache;
#                                    --from FILE takes a tarball you already have (the same checksum is required)
#   intelxe-vk prefix-install PREFIX [--dxvk-only|--vkd3d-only]
#                                    DXVK and vkd3d-proton DLLs from the cache into a 64-bit Wine prefix, the prefix's
#                                    own DLLs and DLL overrides kept for prefix-restore; writes PREFIX/dxvk.conf
#   intelxe-vk prefix-restore PREFIX the prefix's own DLLs, overrides and no dxvk.conf, as before prefix-install
#   intelxe-vk minecraft-args [--java PATH] [--debug] [--framelog FILE]
#                                    the JVM argument that puts Minecraft's Vulkan renderer (LWJGL) on ANV, for the
#                                    official launcher or Prism; checks the Java runtimes it finds can load the provider
#   intelxe-vk frametimes FILE [--skip SECONDS]
#                                    summary of a frame log (INTELXE_VK_FRAMELOG): fps, interval percentiles, 1% low
#   intelxe-vk bench --wine PATH --exe PROGRAM [options] [-- ARGS...]
#                                    a D3D benchmark under Wine, A/B: DXVK on ANV vs on MoltenVK behind the same
#                                    provider (also the loader, and Wine as shipped); "intelxe-vk bench --help"
#   intelxe-vk bench-report DIR      the table of a bench folder again (medians per mode, anv/mvk ratios)
# Environment: WINE=<path to wine> for the registry steps (default: wine or wine64 in PATH); INTELXE_VK_DEBUG=1 makes
# the provider log to stderr; INTELXE_VK_FRAMELOG=FILE makes it log present intervals (%p = the process id).
set -euo pipefail
VK=${INTELXE_VK_ROOT:-/Library/IntelXe/Vulkan}                         # INTELXE_VK_ROOT, INTELXE_VK_ANV: for tests
ANV=${INTELXE_VK_ANV:-/Library/GPUBundles/nvmtl/libvulkan_intel.dylib}
ICD=$VK/icd.d/intel_icd.x86_64.json
CACHE="$HOME/Library/Application Support/IntelXe/vulkan"
PREFIXES="$CACHE/prefixes.txt"

# Pinned releases. sha256 = the digest GitHub lists for the release asset (checked against it on 12 Nov 2026).
DXVK_VER=3.1.1
DXVK_URL=https://github.com/doitsujin/dxvk/releases/download/v$DXVK_VER/dxvk-$DXVK_VER.tar.gz
DXVK_SHA=40565b4a724aadc4433fa4e010b4b23916d9b1f1baeee64e17186db94f54e608
VKD3D_VER=3.1
VKD3D_URL=https://github.com/HansKristian-Work/vkd3d-proton/releases/download/v$VKD3D_VER/vkd3d-proton-$VKD3D_VER.tar.zst
VKD3D_SHA=b85ea8219b71093a3924913dd7aae6172333dc0c069983ed510816d67f02120b
DXVK_DLLS="d3d8 d3d9 d3d10core d3d11 dxgi"
VKD3D_DLLS="d3d12 d3d12core"
OVR='HKEY_CURRENT_USER\Software\Wine\DllOverrides'

die() { echo "intelxe-vk: $*" >&2; exit 1; }
usage() { sed -n '6,31p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
amfi_off() { case "$(nvram boot-args 2>/dev/null)" in *amfi_get_out_of_my_way=1*|*amfi_get_out_of_my_way=0x1*|*amfi=0x80*|*amfi=128*) return 0;; esac; return 1; }

# ---- Wine builds: which name win32u.so dlopen()s (configure's SONAME_LIBVULKAN) decides what "run" has to provide
win32u_of() {
    local w=$1
    case "$w" in */bin/wine|*/bin/wine64) w=$(cd "$(dirname "$w")/.." && pwd);; esac
    find "$w" -path '*x86_64-unix/win32u.so' -type f 2>/dev/null | head -1
}
wine_info() {
    local u so ver
    u=$(win32u_of "$1")
    [ -n "$u" ] || { echo "  $1: no x86_64-unix/win32u.so found (not a Wine 9+ build?)"; return; }
    so=$(grep -a -o -m1 -E 'lib(MoltenVK|vulkan\.1)\.dylib' "$u" | head -1 || true)
    ver=$(grep -a -o -m1 -E 'wine-[0-9]+\.[0-9.]+[0-9a-z-]*' "$(dirname "$u")/ntdll.so" 2>/dev/null | head -1 || true)
    echo "  $1"
    echo "    ${ver:-version unknown}, Vulkan library: ${so:-NONE (built without Vulkan)}"
    case "$so" in
        libMoltenVK.dylib) echo "    run: intelxe-vk run wine ...   (the provider as libMoltenVK.dylib; --loader for the Khronos loader under that name)";;
        libvulkan.1.dylib) echo "    run: intelxe-vk run wine ...   (the provider as libvulkan.1.dylib); or its own bundled loader with"
                           echo "         VK_DRIVER_FILES=$ICD (intelxe-vk run --loader sets that too)";;
    esac
}
find_wines() {
    local a
    for a in /Applications/Wine*.app "$HOME"/Applications/Wine*.app /Applications/CrossOver.app; do [ -d "$a" ] && echo "$a"; done
    for a in wine wine64; do command -v $a 2>/dev/null || true; done
}

check() {
    echo "== native Vulkan (experimental)"
    if [ -f $VK/lib/libintelxe-vk.dylib ]; then echo "  provider: $(grep -a -o -m1 'intelxe-vk-provider [0-9]*' $VK/lib/libintelxe-vk.dylib || echo '?') in $VK"
    else echo "  provider: NOT INSTALLED (sudo ./install.sh in the -vulkan package)"; fi
    [ -f $ANV ] && echo "  ANV: $ANV" || echo "  ANV: MISSING (the driver is not installed)"
    [ -e /usr/local/lib/libvulkan.1.dylib ] && echo "  Khronos loader: /usr/local/lib/libvulkan.1.dylib (run --loader possible)" || echo "  Khronos loader: none (run --loader needs zink-gl)"
    amfi_off && echo "  AMFI boot-arg: set (DYLD_* reach games started through shell-script launchers)" ||
        echo "  AMFI boot-arg: NOT SET: macOS drops DYLD_LIBRARY_PATH for protected programs such as /bin/sh, so run works only for commands that are binaries"
    echo "  DLL cache ($CACHE):"
    [ -f "$CACHE/dxvk-$DXVK_VER/x64/d3d11.dll" ] && echo "    DXVK $DXVK_VER" || echo "    DXVK $DXVK_VER: not fetched (intelxe-vk fetch)"
    [ -f "$CACHE/vkd3d-proton-$VKD3D_VER/x64/d3d12.dll" ] && echo "    vkd3d-proton $VKD3D_VER" || echo "    vkd3d-proton $VKD3D_VER: not fetched (intelxe-vk fetch)"
    echo "== Wine builds"
    local w found=0
    if [ $# -gt 0 ]; then wine_info "$1"; found=1
    else while IFS= read -r w; do [ -n "$w" ] && { wine_info "$w"; found=1; }; done < <(find_wines); fi
    [ $found = 1 ] || echo "  none found (intelxe-vk check /path/to/Wine.app)"
    echo "== prefixes"
    local p seen=""
    { [ -f "$PREFIXES" ] && cat "$PREFIXES"; echo "$HOME/.wine"; } | while IFS= read -r p; do
        [ -d "$p" ] || continue
        case " $seen " in *" $p "*) continue;; esac; seen="$seen $p"
        if [ -f "$p/.intelxe-vk/installed" ]; then echo "  $p: $(tr '\n' ' ' < "$p/.intelxe-vk/installed")"
        else echo "  $p: Wine's own D3D (no prefix-install)"; fi
    done
}

# ---- run: DYLD_LIBRARY_PATH for this process (and the Wine processes it starts) only
run() {
    local mode=provider dir
    [ "${1:-}" = --loader ] && { mode=loader; shift; }
    [ $# -gt 0 ] || usage
    [ -f $ANV ] || die "the driver is not installed ($ANV)"
    if [ $mode = provider ]; then
        dir=$VK/provider
        [ -e $dir/libMoltenVK.dylib ] || die "the provider is not installed ($dir)"
    else
        dir=$VK/loader
        [ -e $dir/libMoltenVK.dylib ] || die "--loader needs the Khronos loader in /usr/local/lib (install zink-gl)"
    fi
    export DYLD_LIBRARY_PATH="$dir${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}"
    # ANV only, also for a loader the process loads by itself (Wine builds that bundle one; MoltenVK's manifest
    # otherwise adds a second, emulated GPU that DXVK may pick)
    export VK_DRIVER_FILES=$ICD VK_ICD_FILENAMES=$ICD
    # INTELXE_VK_DEBUG/FRAMELOG/ICD of your own survive the Metal plugin only with its per-process opt-in
    if env | grep -q '^INTELXE_VK_'; then export NVMTL_PROCESS_ENV=1; fi
    local p=${WINEPREFIX:-$HOME/.wine}
    if [ -f "$p/.intelxe-vk/installed" ]; then
        [ -n "${DXVK_CONFIG_FILE:-}" ] || [ ! -f "$p/dxvk.conf" ] || export DXVK_CONFIG_FILE="$p/dxvk.conf"
        local d list=""
        for d in $(sed -n 's/^dlls=//p' "$p/.intelxe-vk/installed"); do list="$list${list:+,}$d"; done
        # the registry has these overrides already (prefix-install); the variable covers a prefix whose registry was
        # reset. A WINEDLLOVERRIDES of your own is left alone.
        if [ -n "$list" ] && [ -z "${WINEDLLOVERRIDES:-}" ]; then export WINEDLLOVERRIDES="$list=n,b"; fi
    fi
    amfi_off || echo "intelxe-vk: no AMFI boot-arg: if CMD is a shell script, DYLD_LIBRARY_PATH may not reach the game" >&2
    echo "intelxe-vk: $mode ($dir), prefix ${WINEPREFIX:-~/.wine}${DXVK_CONFIG_FILE:+, $DXVK_CONFIG_FILE}" >&2
    exec "$@"
}

# ---- fetch: explicit downloads only, every file checked against the pinned sha256 before it is unpacked
sha_ok() { [ "$(shasum -a 256 "$1" | cut -c1-64)" = "$2" ]; }
unpack() { # unpack TARBALL SHA NAME
    local t=$1 sha=$2 name=$3 tmp
    sha_ok "$t" "$sha" || die "$t: sha256 differs from the pinned $sha: refused"
    tmp="$CACHE/.unpack"; rm -rf "$tmp"; mkdir -p "$tmp"
    case "$t" in
        *.tar.gz) tar -xzf "$t" -C "$tmp" ;;
        *.tar.zst) command -v zstd >/dev/null || die "$t is zstd-compressed and macOS's tar cannot read zstd: install zstd (e.g. brew install zstd), then fetch --from $t"
                   zstd -dc "$t" | tar -xf - -C "$tmp" ;;
    esac
    [ -d "$tmp/$name/x64" ] || die "$t does not hold $name/x64"
    rm -rf "${CACHE:?}/$name"; mv "$tmp/$name" "$CACHE/$name"; rm -rf "$tmp"
    echo "  $CACHE/$name"
}
fetch() {
    mkdir -p "$CACHE"
    if [ "${1:-}" = --from ]; then
        local f=${2:?fetch --from FILE}
        case "$(basename "$f")" in
            "dxvk-$DXVK_VER.tar.gz") unpack "$f" $DXVK_SHA dxvk-$DXVK_VER ;;
            "vkd3d-proton-$VKD3D_VER.tar.zst") unpack "$f" $VKD3D_SHA vkd3d-proton-$VKD3D_VER ;;
            *) die "expected dxvk-$DXVK_VER.tar.gz or vkd3d-proton-$VKD3D_VER.tar.zst" ;;
        esac
        return
    fi
    local u f
    for u in $DXVK_URL $VKD3D_URL; do
        f="$CACHE/$(basename "$u")"
        echo "== $u"
        curl -fL --proto '=https' -o "$f.part" "$u" && mv "$f.part" "$f"
    done
    unpack "$CACHE/dxvk-$DXVK_VER.tar.gz" $DXVK_SHA dxvk-$DXVK_VER
    unpack "$CACHE/vkd3d-proton-$VKD3D_VER.tar.zst" $VKD3D_SHA vkd3d-proton-$VKD3D_VER
}

# ---- prefixes
wine_cmd() { if [ -n "${WINE:-}" ]; then echo "$WINE"; else command -v wine 2>/dev/null || command -v wine64 2>/dev/null || true; fi; }
prefix_check() {
    local p=$1
    [ -f "$p/system.reg" ] && [ -d "$p/drive_c/windows/system32" ] || die "$p is not a Wine prefix (no system.reg / drive_c/windows/system32)"
    grep -q '^#arch=win32' "$p/system.reg" && die "$p is a 32-bit prefix: only 64-bit prefixes are supported (32-bit games run in a 64-bit prefix through WoW64)"
    return 0
}
# the value of one override now, "-" if there is none (wine reg query lists "    name    REG_SZ    value")
ovr_now() { awk -v n="$2" 'tolower($1) == n && $2 == "REG_SZ" { $1 = ""; $2 = ""; sub(/^ +/, ""); print; f = 1 } END { if (!f) print "-" }' "$1"; }

prefix_install() {
    local p=${1:?prefix-install PREFIX}; shift
    p=$(cd "$p" && pwd)
    prefix_check "$p"
    local dxvk=1 vkd3d=1
    case "${1:-}" in --dxvk-only) vkd3d=0;; --vkd3d-only) dxvk=0;; "") ;; *) usage;; esac
    local DX="$CACHE/dxvk-$DXVK_VER" VD="$CACHE/vkd3d-proton-$VKD3D_VER"
    [ $dxvk = 0 ] || [ -f "$DX/x64/d3d11.dll" ] || die "DXVK $DXVK_VER is not in the cache: intelxe-vk fetch"
    [ $vkd3d = 0 ] || [ -f "$VD/x64/d3d12.dll" ] || die "vkd3d-proton $VKD3D_VER is not in the cache: intelxe-vk fetch"
    local M="$p/.intelxe-vk" S32="$p/drive_c/windows/system32" W64="$p/drive_c/windows/syswow64"
    mkdir -p "$M/backup/system32" "$M/backup/syswow64"
    local list="" d src32 src64
    [ $dxvk = 1 ] && list="$list $DXVK_DLLS"
    [ $vkd3d = 1 ] && list="$list $VKD3D_DLLS"
    for d in $list; do
        case " $DXVK_DLLS " in *" $d "*) src64="$DX/x64"; src32="$DX/x32";; *) src64="$VD/x64"; src32="$VD/x86";; esac
        # the prefix's own file is kept once: a second prefix-install must not back up our copy over it
        if [ ! -e "$M/backup/system32/$d.dll" ] && [ ! -e "$M/backup/system32/$d.dll.none" ]; then
            if [ -f "$S32/$d.dll" ]; then cp -p "$S32/$d.dll" "$M/backup/system32/"; else : > "$M/backup/system32/$d.dll.none"; fi
        fi
        cp "$src64/$d.dll" "$S32/$d.dll"
        if [ -d "$W64" ] && [ -f "$src32/$d.dll" ]; then
            if [ ! -e "$M/backup/syswow64/$d.dll" ] && [ ! -e "$M/backup/syswow64/$d.dll.none" ]; then
                if [ -f "$W64/$d.dll" ]; then cp -p "$W64/$d.dll" "$M/backup/syswow64/"; else : > "$M/backup/syswow64/$d.dll.none"; fi
            fi
            cp "$src32/$d.dll" "$W64/$d.dll"
        fi
    done
    if [ ! -f "$p/dxvk.conf" ] || grep -q '^# written by intelxe-vk' "$p/dxvk.conf"; then
        cat > "$p/dxvk.conf" <<'EOF'
# written by intelxe-vk prefix-install (IntelXe native Vulkan); prefix-restore removes it. intelxe-vk run points
# DXVK_CONFIG_FILE here.
#
# Descriptor buffers (VK_EXT_descriptor_buffer): off. DXVK 3.1.1's own "Auto" already leaves them off on Intel's Mesa
# driver when minSubgroupSize is 16, which it is on Xe2 (dxvk_device_info.cpp); written out so a DXVK update or a
# driver change cannot switch them on unnoticed. The NVIDIA fork lost text with them on NVK.
dxvk.enableDescriptorBuffer = False
# Descriptor heap (VK_EXT_descriptor_heap): ANV offers it and DXVK 3.1.1 would use it on Intel's Mesa driver, but it
# has not run on this driver's kernel yet. False = classic descriptor sets. Set Auto to try it.
dxvk.enableDescriptorHeap = False
EOF
        echo "  $p/dxvk.conf"
    else echo "  keep  $p/dxvk.conf (yours; intelxe-vk recommends dxvk.enableDescriptorBuffer = False)"; fi
    # DLL overrides: native first for each DLL. The values there before are kept for prefix-restore.
    local w; w=$(wine_cmd)
    if [ -n "$w" ]; then
        local q="$M/overrides-now.txt"
        WINEPREFIX="$p" "$w" reg query "$OVR" > "$q" 2>/dev/null || : > "$q"
        for d in $list; do
            grep -q "^$d|" "$M/overrides.txt" 2>/dev/null || echo "$d|$(ovr_now "$q" "$d")" >> "$M/overrides.txt"
            WINEPREFIX="$p" "$w" reg add "$OVR" /v "$d" /d native /f >/dev/null
        done
        rm -f "$q"
        echo "  DLL overrides set with $w"
    else
        echo "  no wine found (set WINE=/path/to/wine): DLL overrides not written; intelxe-vk run sets WINEDLLOVERRIDES instead"
    fi
    { echo "dlls=$(echo $list)"; [ $dxvk = 1 ] && echo "dxvk=$DXVK_VER"; [ $vkd3d = 1 ] && echo "vkd3d-proton=$VKD3D_VER"; echo "date=$(date +%Y-%m-%d)"; } > "$M/installed"
    mkdir -p "$CACHE"; grep -qxF "$p" "$PREFIXES" 2>/dev/null || echo "$p" >> "$PREFIXES"
    echo "installed into $p:$list. Start games with: WINEPREFIX=\"$p\" intelxe-vk run wine game.exe"
}

prefix_restore() {
    local p=${1:?prefix-restore PREFIX}
    p=$(cd "$p" && pwd)
    local M="$p/.intelxe-vk" d f dir
    [ -d "$M/backup" ] || die "$p has no intelxe-vk backup"
    for dir in system32 syswow64; do
        for f in "$M/backup/$dir"/*; do
            [ -e "$f" ] || continue
            d=$(basename "$f")
            case "$d" in
                *.dll.none) rm -f "$p/drive_c/windows/$dir/${d%.none}" ;;
                *.dll) cp -p "$f" "$p/drive_c/windows/$dir/$d" ;;
            esac
        done
    done
    if [ -f "$M/overrides.txt" ]; then
        local w; w=$(wine_cmd)
        if [ -n "$w" ]; then
            while IFS='|' read -r d f; do
                if [ "$f" = - ]; then WINEPREFIX="$p" "$w" reg delete "$OVR" /v "$d" /f >/dev/null 2>&1 || true
                else WINEPREFIX="$p" "$w" reg add "$OVR" /v "$d" /d "$f" /f >/dev/null; fi
            done < "$M/overrides.txt"
            echo "  DLL overrides restored with $w"
        else
            die "no wine found to restore the DLL overrides (set WINE=/path/to/wine); the DLLs are back, $M is kept"
        fi
    fi
    grep -q '^# written by intelxe-vk' "$p/dxvk.conf" 2>/dev/null && rm -f "$p/dxvk.conf"
    rm -rf "$M"
    if [ -f "$PREFIXES" ]; then grep -vxF "$p" "$PREFIXES" > "$PREFIXES.new" || true; mv "$PREFIXES.new" "$PREFIXES"; fi
    echo "restored $p: Wine's own D3D again"
}

# ---- frame logs (INTELXE_VK_FRAMELOG): "frame t_ms interval_ms present_ms result swapchain" per present
# ft_stats FILE SKIP_SECONDS: one line of key=value (the first present after SKIP starts the count)
ft_stats() {
    local f=$1 skip=$2 iv
    iv=$(mktemp -t intelxe-vk) || die "mktemp failed"
    awk -v s="$skip" '/^[0-9]/ { if (!h++) t0 = $2 } /^[0-9]/ && $2 - t0 >= s * 1000 { if (n++) print $3 }' "$f" | sort -g > "$iv"
    awk -v s="$skip" '/^[0-9]/ { if (!h++) z = $2 } /^[0-9]/ && $2 - z >= s * 1000 {
            n++; if (n == 1) t0 = $2; t1 = $2; ps += $4; if ($4 > pm) pm = $4; if ($5 < 0) bad++ }
        END { printf "frames=%d secs=%.2f present_avg=%.3f present_max=%.3f errors=%d", n, (t1 - t0) / 1000, n ? ps / n : 0, pm, bad }' "$f"
    # percentiles of the sorted intervals; 1% low = the frame rate of the slowest 1% of intervals
    awk '{ v[NR] = $1; s += $1 } END {
        n = NR
        if (!n) { print " intervals=0 fps=0 avg=0 p50=0 p95=0 p99=0 max=0 low1=0"; exit }
        k = int(n / 100); if (k < 1) k = 1
        for (i = n - k + 1; i <= n; i++) w += v[i]
        printf " intervals=%d fps=%.1f avg=%.3f p50=%.3f p95=%.3f p99=%.3f max=%.3f low1=%.1f\n", n, (s > 0 ? 1000 * n / s : 0),
            s / n, v[int(.5 * (n - 1) + 1.5)], v[int(.95 * (n - 1) + 1.5)], v[int(.99 * (n - 1) + 1.5)], v[n], (w > 0 ? 1000 * k / w : 0) }' "$iv"
    rm -f "$iv"
}
kv() { local v; v=$(sed -n "s/.* $1=\([^ ]*\).*/\1/p" <<< " $2"); echo "${v:--}"; }

frametimes() {
    local f=${1:-} skip=0 l
    [ -n "$f" ] || die "usage: intelxe-vk frametimes FILE [--skip SECONDS]"
    shift
    if [ "${1:-}" = --skip ]; then skip=${2:?--skip SECONDS}; fi
    [ -f "$f" ] || die "$f: no such file"
    l=$(ft_stats "$f" "$skip")
    echo "frames $(kv frames "$l") ($(kv intervals "$l") intervals) in $(kv secs "$l") s$([ "$skip" = 0 ] || echo ", the first $skip s skipped")"
    echo "fps $(kv fps "$l") (interval avg $(kv avg "$l") ms), 1% low $(kv low1 "$l") fps"
    echo "interval ms: p50 $(kv p50 "$l") p95 $(kv p95 "$l") p99 $(kv p99 "$l") max $(kv max "$l")"
    echo "vkQueuePresentKHR ms: avg $(kv present_avg "$l") max $(kv present_max "$l"); presents that failed: $(kv errors "$l")"
    echo "summary $l"
}

# ---- Minecraft: LWJGL takes the Vulkan library from org.lwjgl.vulkan.libname (org/lwjgl/vulkan/VK.java create():
# on macOS the property, with no fallback when set; else its bundled MoltenVK, else libvulkan.1.dylib). GLFW is then
# pointed at the same file (GLFWVulkan's static init calls setPath(VK.getFunctionProvider()) on macOS).
java_check() {
    local j=$1 ent
    [ -x "$j" ] || { echo "  $j: not an executable" >&2; return; }
    local arch; arch=$(file -b "$j" 2>/dev/null)
    case "$arch" in
        *x86_64*) ;;
        *) echo "  $j: $arch: the provider is x86_64 only (an arm64 Java cannot load it)" >&2; return ;;
    esac
    ent=$(codesign -d --entitlements - "$j" 2>/dev/null || true)
    if grep -q 'disable-library-validation' <<< "$ent"; then
        echo "  $j: x86_64, library validation off (entitlement): loads the ad-hoc signed provider" >&2
    elif codesign -dv "$j" 2>&1 | grep -q 'flags=.*runtime'; then
        if amfi_off; then echo "  $j: x86_64, hardened runtime without disable-library-validation; the AMFI boot-arg lets it load the provider" >&2
        else echo "  $j: x86_64, hardened runtime without disable-library-validation: it would refuse the ad-hoc signed provider (use another Java)" >&2; fi
    else
        echo "  $j: x86_64, no hardened runtime: loads the provider" >&2
    fi
}

# Where launchers keep Java: Mojang's runtime (official launcher; TLauncher can use it too), TLauncher's, Prism's and
# MultiMC's, and installed JDKs. bin/java may be a link (some runtimes link it); each real file is listed once.
java_roots() {
    local a="$HOME/Library/Application Support" d
    for d in "$a/minecraft/runtime" "$a/minecraft/jre" "$a/tlauncher" "$a/.tlauncher" "$HOME/.tlauncher" "$a/minecraft/tlauncher" \
             "$a/PrismLauncher/java" "$a/MultiMC/java" /Library/Java/JavaVirtualMachines "$HOME/Library/Java/JavaVirtualMachines"; do
        [ -d "$d" ] && echo "$d"
    done
    return 0
}
find_javas() {
    local r j seen=" "
    while IFS= read -r r; do
        while IFS= read -r j; do
            j=$(cd "$(dirname "$j")" 2>/dev/null && echo "$(pwd -P)/$(basename "$j")") || continue
            case "$seen" in *" $j "*) continue;; esac
            seen="$seen$j "; echo "$j"
        done < <(find "$r" -maxdepth 10 -path '*/bin/java' \( -type f -o -type l \) 2>/dev/null)
    done < <(java_roots)
}

minecraft_args() {
    local java="" debug=0 flog="" lib=$VK/lib/libintelxe-vk.dylib args j
    while [ $# -gt 0 ]; do
        case "$1" in
            --java) java=${2:?--java PATH}; shift 2 ;;
            --debug) debug=1; shift ;;
            --framelog) flog=${2:?--framelog FILE}; shift 2 ;;
            *) usage ;;
        esac
    done
    args="-Dorg.lwjgl.vulkan.libname=$lib"
    [ $debug = 0 ] || args="$args -Dorg.lwjgl.util.Debug=true -Dorg.lwjgl.util.DebugLoader=true"
    echo "$args"   # stdout: the arguments only, for scripts; the notes go to stderr
    cat >&2 <<EOF

Minecraft's Vulkan renderer on ANV (EXPERIMENTAL; the same argument naming the Khronos loader, with ANV's manifest, ran
Minecraft 26.3's Vulkan renderer on the B580 on 29 Oct). Add the line above to the JVM arguments:
  official launcher: Installations > the profile > Edit > More options > JVM arguments (append, keep what is there)
  Prism Launcher:    the instance > Edit > Settings > Java > JVM arguments (tick the box; append)
  TLauncher:         its JVM arguments setting (minecraft.javaargs in its legacy.properties)
then choose the Vulkan renderer in Minecraft's video settings. Keep zink-gl's arguments if you have them: they only
matter to the OpenGL renderer.
  How it works: Minecraft loads Vulkan with LWJGL's VK.create() (explicit init, NativeLibrariesBootstrap), which
  opens exactly the file org.lwjgl.vulkan.libname names (no MoltenVK fallback when it is set), and hands that same
  file to its window layer: GLFW through LWJGL's GLFWVulkan.setPath (26.2), SDL3 through SDL_Vulkan_LoadLibrary with
  VK's path (26.3). So the window surface (VK_EXT_metal_surface) reaches ANV too, and no mod is needed. Minecraft
  uses VK_KHR_portability_enumeration and VK_KHR_portability_subset, written for MoltenVK: the provider accepts the
  first and drops the second if it is requested (ANV is not a portability driver). Device functions are ANV's own;
  the provider adds nothing per call.
  Check: in-game F3 names "Intel open-source Mesa driver" (through MoltenVK it would say MoltenVK); --debug adds
  LWJGL's loader log ("Loaded library: .../libintelxe-vk.dylib"); INTELXE_VK_DEBUG=1 in the game's environment logs
  the instance and device extensions it asks for.
EOF
    [ -f "$lib" ] || echo "  NOTE: $lib is not installed (sudo ./install.sh in the -vulkan package)." >&2
    if [ -n "$flog" ]; then
        cat >&2 <<EOF
  Frame times (INTELXE_VK_FRAMELOG, read with intelxe-vk frametimes): the variable must be in the game's environment.
    Prism: the instance > Edit > Settings > Custom commands > Wrapper command:
        /usr/bin/env NVMTL_PROCESS_ENV=1 INTELXE_VK_FRAMELOG=$flog
    official launcher: quit it, then start it from Terminal so the game inherits the variables:
        NVMTL_PROCESS_ENV=1 INTELXE_VK_FRAMELOG=$flog /Applications/Minecraft.app/Contents/MacOS/launcher
    (NVMTL_PROCESS_ENV=1: the Metal driver's plugin keeps the process's INTELXE*/MESA_* variables; the provider also
    keeps its own copy from when LWJGL loaded it, which in Minecraft is before the window)
EOF
    fi
    echo "Java runtimes (the provider needs an x86_64 Java that may load an ad-hoc signed library):" >&2
    if [ -n "$java" ]; then java_check "$java"
    else
        local found=0
        while IFS= read -r j; do [ -n "$j" ] && { java_check "$j"; found=1; }; done < <(find_javas)
        [ $found = 1 ] || echo "  none found (looked in: $(java_roots | tr '\n' ' ')); --java PATH checks one" >&2
    fi
}

# ---- bench: one D3D benchmark under Wine, the modes interleaved run by run
bench_help() {
    cat <<'EOF'
intelxe-vk bench --wine PATH --exe PROGRAM [options] [-- ARGS...]
  --wine PATH          wine (or wine64), its bin/ folder, or a Wine .app (required)
  --wineserver PATH    default: wineserver beside wine
  --exe PROGRAM        what wine starts: a host path to the .exe (run from its folder) or a Windows path (required)
  --prefix DIR         the Wine prefix (default: WINEPREFIX, else ~/.wine); with DXVK from "intelxe-vk prefix-install"
  --prefix-MODE DIR    another prefix for one mode, e.g. --prefix-mvk with a DXVK build that runs on MoltenVK
  --modes LIST         comma-separated, default anv,mvk:
                         anv     the provider -> ANV                       (frame log, Mesa WSI log)
                         mvk     the provider -> MoltenVK (INTELXE_VK_ICD) (frame log): same front end, other driver
                         loader  the Khronos loader -> ANV (VK_DRIVER_FILES) (Mesa WSI log)
                         wine    Wine as shipped (its own MoltenVK or loader) (the benchmark's own numbers only)
  --moltenvk PATH      libMoltenVK.dylib for mvk (default: the one inside the Wine build, else /usr/local/lib)
  --provider DIR       a folder with the provider as libMoltenVK.dylib and libvulkan.1.dylib (default: the installed one)
  --runs N             runs per mode, interleaved anv mvk anv mvk ... (default 3)
  --seconds S          stop the program after S seconds (wineserver -k); default 0 = wait until it exits
  --timeout S          hard limit per run (default 600)
  --warmup S           frames of the first S seconds are not counted (default 5)
  --score REGEX        the benchmark's own result: the first number after the last match of REGEX (awk) in its
                       output (default: avg_fps=, the RESULT line of user/tests/wine's d3d11bench/d3d12bench)
  --env NAME=VALUE     an extra variable for every run (repeatable), e.g. DXVK_HUD=fps
  --out DIR            default: ~/Library/Application Support/IntelXe/vulkan/bench/DATE-TIME
Each run gets DIR/NN-MODE/ (out.log, frames-PID.txt, wsi.txt, DXVK's logs); DIR/results.tsv has a line per run and
"intelxe-vk bench-report DIR" prints the medians per mode and anv/mvk ratios.
EOF
}

# the variables of one mode, in the subshell that starts wine
bench_env() {
    local mode=$1 rd=$2
    unset DYLD_LIBRARY_PATH VK_DRIVER_FILES VK_ICD_FILENAMES INTELXE_VK_ICD INTELXE_VK_FRAMELOG MESA_VK_WSI_FPS_LOG
    case $mode in
        anv) export DYLD_LIBRARY_PATH=$B_PROVIDER VK_DRIVER_FILES=$ICD VK_ICD_FILENAMES=$ICD \
                    INTELXE_VK_FRAMELOG="$rd/frames-%p.txt" MESA_VK_WSI_FPS_LOG="$rd/wsi.txt" ;;
        mvk) export DYLD_LIBRARY_PATH=$B_PROVIDER INTELXE_VK_ICD=$B_MVKLINK INTELXE_VK_FRAMELOG="$rd/frames-%p.txt" ;;
        loader) export DYLD_LIBRARY_PATH=$VK/loader VK_DRIVER_FILES=$ICD VK_ICD_FILENAMES=$ICD MESA_VK_WSI_FPS_LOG="$rd/wsi.txt" ;;
        wine) ;;
    esac
    # The Metal driver's plugin, which Wine's window loads before Vulkan, unsets inherited INTELXE*/MESA_* variables
    # unless the process opts in (nullmoth/plugin/nvmtl_env_knobs.h): without this the frame log, INTELXE_VK_ICD
    # (MoltenVK!) and Mesa's WSI log would silently not apply. The same opt-in in every mode keeps the A/B fair.
    export NVMTL_PROCESS_ENV=1
    export INTELXE_VK_BENCH_MODE=$mode DXVK_LOG_PATH=$rd WINEDEBUG=${WINEDEBUG:--all}
    local e
    for e in "${B_ENV[@]+"${B_ENV[@]}"}"; do export "${e?}"; done
}

# one result line (tab-separated) for a finished run folder
bench_parse() {
    local rd=$1 mode=$2 run=$3 rc=$4 how=$5 f best="" n=0 c l shown score dev
    for f in "$rd"/frames-*.txt; do
        [ -f "$f" ] || continue
        c=$(grep -c '^[0-9]' "$f" || true)
        if [ "$c" -gt "$n" ]; then n=$c; best=$f; fi
    done
    if [ -n "$best" ]; then l=$(ft_stats "$best" "$B_WARMUP"); else l=""; fi
    shown=-
    if [ -f "$rd/wsi.txt" ]; then
        shown=$(awk -v w="$B_WARMUP" '{ if (!h++) t0 = $1; if ($1 - t0 < w) next
                    for (i = 2; i <= NF; i++) if ($i == "shown/s,") { s += $(i - 1); k++ } }
                 END { if (k) printf "%.1f", s / k; else print "-" }' "$rd/wsi.txt")
    fi
    score=$(awk -v re="$B_SCORE" 'match($0, re) { r = substr($0, RSTART + RLENGTH); if (match(r, /-?[0-9]+(\.[0-9]+)?/)) v = substr(r, RSTART, RLENGTH) }
                                 END { print (v == "" ? "-" : v) }' "$rd/out.log")
    # DXVK's log: the adapter line before the first "Driver :" line
    dev=$(cat "$rd"/*.log 2>/dev/null | awk '/Driver *:/ && !d { sub(/^[a-z]+: +/, "", p); sub(/:$/, "", p); print p; d = 1 } { p = $0 }' | head -1)
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$run" "$mode" "$rc" "$how" "$(kv frames "$l")" "$(kv fps "$l")" \
        "$(kv p50 "$l")" "$(kv p99 "$l")" "$(kv max "$l")" "$(kv low1 "$l")" "$shown" "$score" "${dev:--}" "$(basename "$rd")"
}

bench() {
    local wine="" wsrv="" exe="" prefix=${WINEPREFIX:-$HOME/.wine} modes=anv,mvk mvk="" runs=3 secs=0 tmo=600 out=""
    local -a pargs=()
    local v
    local pfx_anv="" pfx_mvk="" pfx_loader="" pfx_wine=""
    B_PROVIDER=$VK/provider B_WARMUP=5 B_SCORE='avg_fps='; B_ENV=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --help|-h) bench_help; return 0 ;;
            --wine) wine=${2:?}; shift 2 ;;
            --wineserver) wsrv=${2:?}; shift 2 ;;
            --exe) exe=${2:?}; shift 2 ;;
            --prefix) prefix=${2:?}; shift 2 ;;
            --prefix-anv) pfx_anv=${2:?}; shift 2 ;;
            --prefix-mvk) pfx_mvk=${2:?}; shift 2 ;;
            --prefix-loader) pfx_loader=${2:?}; shift 2 ;;
            --prefix-wine) pfx_wine=${2:?}; shift 2 ;;
            --modes) modes=${2:?}; shift 2 ;;
            --moltenvk) mvk=${2:?}; shift 2 ;;
            --provider) B_PROVIDER=${2:?}; shift 2 ;;
            --runs) runs=${2:?}; shift 2 ;;
            --seconds) secs=${2:?}; shift 2 ;;
            --timeout) tmo=${2:?}; shift 2 ;;
            --warmup) B_WARMUP=${2:?}; shift 2 ;;
            --score) B_SCORE=${2:?}; shift 2 ;;
            --env) case "${2:?}" in *=*) B_ENV+=("$2");; *) die "--env NAME=VALUE";; esac; shift 2 ;;
            --out) out=${2:?}; shift 2 ;;
            --) shift; pargs=("$@"); break ;;
            *) die "bench: unknown option $1 (intelxe-vk bench --help)" ;;
        esac
    done
    [ -n "$wine" ] && [ -n "$exe" ] || { bench_help >&2; exit 2; }
    for v in "$runs" "$secs" "$tmo" "$B_WARMUP"; do case "$v" in ''|*[!0-9]*) die "bench: --runs/--seconds/--timeout/--warmup take whole numbers";; esac; done
    # wine: a .app, a bin/ folder, or the program
    if [ -d "$wine" ]; then
        local c
        for c in "$wine/bin/wine" "$wine/bin/wine64" "$wine/Contents/Resources/wine/bin/wine" "$wine/Contents/Resources/wine/bin/wine64"; do
            [ -x "$c" ] && { wine=$c; break; }
        done
    fi
    [ -f "$wine" ] && [ -x "$wine" ] || die "bench: no wine program at $wine"
    [ -n "$wsrv" ] || wsrv=$(dirname "$wine")/wineserver
    [ -x "$wsrv" ] || die "bench: no wineserver at $wsrv (--wineserver)"
    local wroot; wroot=$(cd "$(dirname "$wine")/.." && pwd)
    local m
    IFS=, read -r -a B_MODES <<< "$modes"
    for m in "${B_MODES[@]}"; do
        case $m in
            anv) [ -f "$ANV" ] || die "bench: anv needs the driver ($ANV)"
                 [ -e "$B_PROVIDER/libMoltenVK.dylib" ] || die "bench: anv needs the provider in $B_PROVIDER (sudo ./install.sh, or --provider DIR)" ;;
            mvk) [ -e "$B_PROVIDER/libMoltenVK.dylib" ] || die "bench: mvk needs the provider in $B_PROVIDER"
                 [ -n "$mvk" ] || mvk=$(find "$wroot" -name libMoltenVK.dylib \( -type f -o -type l \) 2>/dev/null | head -1)
                 [ -n "$mvk" ] || { [ -f /usr/local/lib/libMoltenVK.dylib ] && mvk=/usr/local/lib/libMoltenVK.dylib; } || true
                 [ -n "$mvk" ] && [ -e "$mvk" ] || die "bench: mvk needs MoltenVK (--moltenvk PATH; none in $wroot or /usr/local/lib)" ;;
            loader) [ -e "$VK/loader/libMoltenVK.dylib" ] || die "bench: loader needs the Khronos loader (zink-gl) and the provider install" ;;
            wine) ;;
            *) die "bench: unknown mode $m (anv, mvk, loader, wine)" ;;
        esac
    done
    [ -n "$out" ] || out="$CACHE/bench/$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$out"
    out=$(cd "$out" && pwd)
    if [ -n "$mvk" ]; then
        # under another leaf name: dyld looks the leaf name up in DYLD_LIBRARY_PATH first, and there libMoltenVK.dylib
        # is the provider itself
        mkdir -p "$out/.mvk"; ln -sf "$mvk" "$out/.mvk/libMoltenVK-icd.dylib"; B_MVKLINK=$out/.mvk/libMoltenVK-icd.dylib
    fi
    local cwd=$PWD
    [ -f "$exe" ] && cwd=$(cd "$(dirname "$exe")" && pwd)
    {
        echo "# intelxe-vk bench $(date '+%Y-%m-%d %H:%M:%S')"
        echo "wine=$wine ($("$wine" --version 2>/dev/null || echo '?'))"
        echo "wineserver=$wsrv"; echo "exe=$exe"; echo "args=${pargs[*]+"${pargs[*]}"}"; echo "cwd=$cwd"
        echo "prefix=$prefix anv=${pfx_anv:-=} mvk=${pfx_mvk:-=} loader=${pfx_loader:-=} wine=${pfx_wine:-=}"
        echo "modes=$modes runs=$runs seconds=$secs timeout=$tmo warmup=$B_WARMUP score=$B_SCORE"
        echo "provider=$B_PROVIDER moltenvk=${mvk:--} icd=$ICD"
        echo "env=${B_ENV[*]+"${B_ENV[*]}"}"
    } > "$out/bench.txt"
    printf 'run\tmode\texit\thow\tframes\tfps\tp50_ms\tp99_ms\tmax_ms\tlow1_fps\tshown_fps\tscore\tdevice\tdir\n' > "$out/results.tsv"
    local r rd p pid t lim how rc k=0
    for ((r = 1; r <= runs; r++)); do
        for m in "${B_MODES[@]}"; do
            k=$((k + 1)); rd=$(printf '%s/%02d-%s' "$out" $k "$m"); mkdir -p "$rd"
            case $m in anv) p=${pfx_anv:-$prefix};; mvk) p=${pfx_mvk:-$prefix};; loader) p=${pfx_loader:-$prefix};; *) p=${pfx_wine:-$prefix};; esac
            [ -d "$p" ] || die "bench: prefix $p does not exist"
            WINEPREFIX="$p" "$wsrv" -k >/dev/null 2>&1 || true   # nothing of an earlier run left in the prefix
            echo "== run $r/$runs $m (prefix $p)" >&2
            (
                cd "$cwd"
                export WINEPREFIX="$p"
                [ -f "$p/dxvk.conf" ] && [ -z "${DXVK_CONFIG_FILE:-}" ] && export DXVK_CONFIG_FILE="$p/dxvk.conf"
                bench_env "$m" "$rd"
                env | grep -E '^(DYLD_LIBRARY_PATH|VK_DRIVER_FILES|INTELXE_VK_|MESA_VK_WSI|DXVK_|WINE)' | sort > "$rd/env.txt"
                exec "$wine" "$exe" "${pargs[@]+"${pargs[@]}"}"
            ) > "$rd/out.log" 2>&1 &
            pid=$!; t=0; lim=$tmo
            [ "$secs" -gt 0 ] && [ "$secs" -lt "$tmo" ] && lim=$secs
            while kill -0 $pid 2>/dev/null && [ $t -lt $lim ]; do sleep 1; t=$((t + 1)); done
            how=exited
            if kill -0 $pid 2>/dev/null; then
                how=stopped; [ "$secs" -gt 0 ] && [ $t -ge "$secs" ] || how=timeout
                WINEPREFIX="$p" "$wsrv" -k >/dev/null 2>&1 || true
                sleep 2; kill -9 $pid 2>/dev/null || true
            fi
            if wait $pid 2>/dev/null; then rc=0; else rc=$?; fi
            bench_parse "$rd" "$m" "$r" "$rc" "$how" >> "$out/results.tsv"
            tail -1 "$out/results.tsv" | awk -F'\t' '{ printf "   %s: %s, %s frames, %s fps (p99 %s ms, 1%% low %s), shown %s/s, score %s, %s\n", $2, $4, $5, $6, $8, $10, $11, $12, $13 }' >&2
        done
    done
    bench_report "$out"
}

bench_report() {
    local d=${1:?usage: intelxe-vk bench-report DIR}
    [ -f "$d/results.tsv" ] || die "$d/results.tsv: no such file"
    [ -f "$d/bench.txt" ] && sed -n '2,4p' "$d/bench.txt"
    echo "results: $d/results.tsv"
    column -t -s "$(printf '\t')" "$d/results.tsv"
    echo
    # medians per mode (runs that exited or were stopped on time; "-" values skipped)
    awk -F'\t' 'NR > 1 && $4 != "timeout" {
            m = $2; if (!(m in seen)) { seen[m] = 1; order[++nm] = m }; runs[m]++
            for (c = 5; c <= 12; c++) if ($c != "-" && $c != "") { k = m SUBSEP c; n[k]++; v[k, n[k]] = $c + 0 } }
        function med(k,   i, j, t, a, cnt) {
            cnt = n[k]; if (!cnt) return "-"
            for (i = 1; i <= cnt; i++) a[i] = v[k, i]
            for (i = 2; i <= cnt; i++) { t = a[i]; for (j = i - 1; j > 0 && a[j] > t; j--) a[j + 1] = a[j]; a[j + 1] = t }
            return cnt % 2 ? a[(cnt + 1) / 2] : (a[cnt / 2] + a[cnt / 2 + 1]) / 2 }
        END {
            printf "%-8s %5s %9s %9s %9s %9s %9s %9s\n", "median", "runs", "fps", "p99_ms", "low1_fps", "shown/s", "score", "frames"
            for (i = 1; i <= nm; i++) { m = order[i]
                fps[m] = med(m SUBSEP 6); sc[m] = med(m SUBSEP 12)
                printf "%-8s %5d %9s %9s %9s %9s %9s %9s\n", m, runs[m],
                    fps[m], med(m SUBSEP 8), med(m SUBSEP 10), med(m SUBSEP 11), sc[m], med(m SUBSEP 5) }
            if (("anv" in seen) && ("mvk" in seen)) {
                printf "anv/mvk: fps %s, score %s\n", (fps["mvk"] != "-" && fps["mvk"] > 0 && fps["anv"] != "-") ? sprintf("%.2fx", fps["anv"] / fps["mvk"]) : "-",
                    (sc["mvk"] != "-" && sc["mvk"] > 0 && sc["anv"] != "-") ? sprintf("%.2fx", sc["anv"] / sc["mvk"]) : "-" }
        }' "$d/results.tsv"
}

case "${1:-}" in
    check) shift; check "$@" ;;
    run) shift; run "$@" ;;
    fetch) shift; fetch "$@" ;;
    prefix-install) shift; prefix_install "$@" ;;
    prefix-restore) shift; prefix_restore "$@" ;;
    minecraft|minecraft-args) shift; minecraft_args "$@" ;;
    frametimes) shift; frametimes "$@" ;;
    bench) shift; bench "$@" ;;
    bench-report) shift; bench_report "$@" ;;
    *) usage ;;
esac
