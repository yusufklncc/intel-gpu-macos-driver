 <78423442+yusufklncc@users.noreply.github.com>
Date: Thu, 12 Nov 2026 15:04:13 +0300
Subject: [PATCH] loader: build and find drivers on macOS

- no <link.h> and no dlinfo(RTLD_DI_LINKMAP) on macOS: the debug trace of
  the resolved driver path is skipped there
- library names are lib<name>.<version>.dylib (libze_intel_gpu.1.dylib)
- size_t and uint64_t are distinct types on macOS (unsigned long and
  unsigned long long): to_string gets its size_t overloads
- DYLD_LIBRARY_PATH is searched for drivers next to LD_LIBRARY_PATH
---
 source/inc/ze_util.h                         |  6 ++++++
 source/loader/linux/driver_discovery_lin.cpp |  9 +++++++++
 source/loader/ze_loader.cpp                  | 10 +++++-----
 source/utils/ze_to_string.h                  |  4 ++--
 4 files changed, 22 insertions(+), 7 deletions(-)

diff --git a/source/inc/ze_util.h b/source/inc/ze_util.h
index a51115b..06d720e 100644
--- a/source/inc/ze_util.h
+++ b/source/inc/ze_util.h
@@ -41,7 +41,9 @@ inline void getLastErrorString(std::string &errorValue) {
 #  define putenv_safe _putenv
 #  define strdup_safe _strdup
 #else
+#  if !defined(__APPLE__) // macOS has no <link.h>; dlinfo users are guarded
 #  include <link.h>
+#  endif
 #  include <dlfcn.h>
 #  define HMODULE void*
 #  define LOAD_DRIVER_LIBRARY(NAME) dlopen(NAME, RTLD_LAZY|RTLD_LOCAL)
@@ -57,6 +59,10 @@ inline void getLastErrorString(std::string &errorValue) {
 #if defined(ANDROID)
 #  define MAKE_LIBRARY_NAME(NAME, VERSION)    "lib" NAME ".so"
 #  define MAKE_LAYER_NAME(NAME)    "lib" NAME ".so"
+#elif defined(__APPLE__)
+// Mach-O names carry the version before the suffix: libze_intel_gpu.1.dylib
+#  define MAKE_LIBRARY_NAME(NAME, VERSION)    "lib" NAME "." VERSION ".dylib"
+#  define MAKE_LAYER_NAME(NAME)    "lib" NAME "." L0_VALIDATION_LAYER_SUPPORTED_VERSION ".dylib"
 #elif !defined(WIN32)
 #  define MAKE_LIBRARY_NAME(NAME, VERSION)    "lib" NAME ".so." VERSION
 #  define MAKE_LAYER_NAME(NAME)    "lib" NAME ".so." L0_VALIDATION_LAYER_SUPPORTED_VERSION
diff --git a/source/loader/linux/driver_discovery_lin.cpp b/source/loader/linux/driver_discovery_lin.cpp
index 3ed5a13..27eb8a6 100644
--- a/source/loader/linux/driver_discovery_lin.cpp
+++ b/source/loader/linux/driver_discovery_lin.cpp
@@ -46,6 +46,15 @@ static std::vector<std::string> getLibrarySearchPaths() {
     auto split = splitPaths(ldLibPath);
     paths.insert(paths.end(), split.begin(), split.end());
   }
+#if defined(__APPLE__)
+  // dyld's search path: a driver staged outside the system locations is found as
+  // on Linux through LD_LIBRARY_PATH.
+  const char* dyldLibPath = getenv("DYLD_LIBRARY_PATH");
+  if (dyldLibPath) {
+    auto split = splitPaths(dyldLibPath);
+    paths.insert(paths.end(), split.begin(), split.end());
+  }
+#endif
 #ifdef L0_LOADER_EXTRA_DRIVER_DIR
   // A driver directory configured at build time (e.g. the install prefix's lib
   // dir, baked in at compile time and relocated on install).  Searched right
