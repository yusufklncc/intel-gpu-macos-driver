+    for (int i = 0; i < H264_MAX_DPB_FRAMES && nb_refs < FF_ARRAY_ELEMS(refs); i++)
+        if (h->long_ref[i] && h->long_ref[i] != pic)
+            refs[nb_refs++] = h->long_ref[i];
+
+    /* the slots the references hold (one each) */
+    for (int i = 0; i < nb_refs; i++) {
+        H264VulkanDecodePicture *rp = refs[i]->hwaccel_picture_private;
+        if (!rp)
+            continue;
+        if (rp->slot_set && rp->slot < max_slots &&
+            !(used & (UINT64_C(1) << rp->slot)))
+            used |= UINT64_C(1) << rp->slot;
+        else
+            rp->slot_set = 0;
+    }
+    /* references never decoded here (frame_num gaps): any free slot */
+    for (int i = 0; i < nb_refs; i++) {
+        H264VulkanDecodePicture *rp = refs[i]->hwaccel_picture_private;
+        if (!rp || rp->slot_set)
+            continue;
+        if ((s = ff_vk_decode_free_dpb_slot(used, max_slots)) < 0)
+            goto full;
+        rp->slot = s;
+        rp->slot_set = 1;
+        used |= UINT64_C(1) << s;
+    }
 
+    /* the current picture: the first field's slot for a second field */
+    if (hp->slot_set && hp->slot < max_slots && !(used & (UINT64_C(1) << hp->slot)))
+        return 0;
+    if ((s = ff_vk_decode_free_dpb_slot(used, max_slots)) < 0)
+        goto full;
+    hp->slot = s;
+    hp->slot_set = 1;
+    return 0;
+
+full:
+    av_log(avctx, AV_LOG_ERROR, "No free DPB slot: the references hold all %u\n",
+           max_slots);
+    return AVERROR_INVALIDDATA;
+}
