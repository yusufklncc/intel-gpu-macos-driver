              "Resizable BAR": "Enabled"
            },
            "Intel(R) UHD Graphics 630": {
              "Manufacturer": "Intel",
              "Codename": "Comet Lake",
              "Device ID": "8086-9BC5",
              "Device Type": "Integrated GPU",
              "PCI Path": "PciRoot(0x0)/Pci(0x2,0x0)",
              "ACPI Path": "\\_SB.PCI0.GFX0"
            }
          },
          "Monitor": {
            "Generic PnP Monitor": {
              "Connector Type": "DP",
              "Resolution": "2560x1440",
              "Connected GPU": "Intel(R) Arc(TM) B580 Graphics"
            }
          }
        }
      },
      "acpi": "gigabyte-z490",
      "macos": "26",
      "expect": {
