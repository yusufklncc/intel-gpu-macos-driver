+    bool isSmallBarConfigAllowed() const override { return true; }
+#else
     bool isSmallBarConfigAllowed() const override { return false; }
+#endif
     bool isLocalMemorySizeNetOfKmdReservations() const override { return true; }
     void *pciBarrierMmap() override;
     bool retrieveMmapOffsetForBufferObject(BufferObject &bo, uint64_t flags, uint64_t &offset) override;
@@ -164,6 +171,7 @@ class IoctlHelperXe : public IoctlHelper {
     std::optional<std::vector<VmBindOpExtDebugData>> addDebugDataAndCreateBindOpVec(BufferObject *bo, uint32_t vmId, bool isAdd) override;
     MOCKABLE_VIRTUAL void setNoVmOvercommitFlagAllowed(bool value) { this->noVmOvercommitFlagAllowed = value; }
     MOCKABLE_VIRTUAL bool getNoVmOvercommitFlagAllowed() { return noVmOvercommitFlagAllowed; }
+    bool isLongRunningVmSupported();
     bool requireBoChunksForLargeHostPtrs() const override { return false; }
     bool setContextGroupPriority(uint32_t drmContextId, uint32_t hwPriority) override;
 
@@ -217,6 +225,7 @@ class IoctlHelperXe : public IoctlHelper {
 
     bool isLowLatencyHintAvailable = false;
     bool noVmOvercommitFlagAllowed = false;
+    int8_t longRunningVmSupport = -1; // -1: not probed yet
     bool noCompressionHintAvailable = false;
     int maxExecQueuePriority = 0;
     std::mutex xeLock;
