From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: intelxe-build <build@localhost>
Date: Fri, 13 Nov 2026 17:23:42 +0300
Subject: [PATCH 7/7] sycl: load ocloc as libocloc.dylib on Darwin

The runtime compilation of OpenCL C (kernel_compiler,
source_language::opencl) loads ocloc's library by name, libocloc.so
outside Windows. On macOS it is libocloc.dylib (compute-runtime's ocloc
built for macOS), found through the dynamic loader's search path.
---
 sycl/source/detail/kernel_compiler/kernel_compiler_opencl.cpp | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/sycl/source/detail/kernel_compiler/kernel_compiler_opencl.cpp b/sycl/source/detail/kernel_compiler/kernel_compiler_opencl.cpp
index 5ec9eae5f..dde8504c5 100644
--- a/sycl/source/detail/kernel_compiler/kernel_compiler_opencl.cpp
+++ b/sycl/source/detail/kernel_compiler/kernel_compiler_opencl.cpp
@@ -74,6 +74,8 @@ void loadOclocLibrary(const std::vector<uint32_t> &IPVersionVec) {
   static const std::vector<std::string_view> OclocPaths = {
       "ocloc64.dll",
       "C:\\Program Files (x86)\\Intel\\oneAPI\\ocloc\\latest\\ocloc64.dll"};
+#elif defined(__SYCL_RT_OS_DARWIN)
+  static const std::vector<std::string_view> OclocPaths = {"libocloc.dylib"};
 #else
   static const std::vector<std::string_view> OclocPaths = {"libocloc.so"};
 #endif
