    {
      "name": "z490-b580-uhd630",
      "about": "the public Z490 PC (Comet Lake) with an Arc B580 in place of its RX 580 and its UHD 630 on: a natively supported iGPU, so OpCore Simplify asks which GPUs to use. Its report's Focusrite USB Audio entry has no Device ID (an older Hardware Sniffer), which OpCore Simplify's report check refuses; this fixture leaves that entry out",
      "report": {
        "source": "gigabyte-z490",
        "replace": {
          "GPU": {
            "Intel(R) Arc(TM) B580 Graphics": {
              "Manufacturer": "Intel",
              "Codename": "Battlemage",
              "Device ID": "8086-E20B",
              "Device Type": "Discrete GPU",
              "PCI Path": "PciRoot(0x0)/Pci(0x1,0x0)/Pci(0x0,0x0)/Pci(0x1,0x0)/Pci(0x0,0x0)",
              "Resizable BAR": "Enabled"
            },
            "Intel(R) UHD Graphics 630": {
              "Manufacturer": "Intel",
              "Codename": "Comet Lake",
              "Device ID": "8086-9BC5",
              "Device Type": "Integrated GPU",
              "PCI Path": "PciRoot(0x0)/Pci(0x2,0x0)",
              "ACPI Path": "\\_SB.PCI0.GFX0"
            }
          },
          "Monitor": {
            "Generic PnP Monitor": {
              "Connector Type": "DP",
              "Resolution": "2560x1440",
              "Connected GPU": "Intel(R) Arc(TM) B580 Graphics"
            }
          },
          "Sound": {
            "SWISSONIC EasyKeys25": {
              "Bus Type": "USB",
              "Device ID": "07FC-1110"
            },
            "Realtek(R) Audio": {
              "Bus Type": "HDAUDIO",
              "Device ID": "10EC-1220",
              "Subsystem ID": "1458A0C3",
              "Audio Endpoints": [
                "Realtek Digital Output"
              ],
              "Controller Device ID": "8086-06C8"
            },
            "AMD High Definition Audio Device": {
              "Bus Type": "HDAUDIO",
              "Device ID": "1002-AA01",
              "Subsystem ID": "00AA0100",
              "Controller Device ID": "1002-AAF0"
            }
          }
        }
      },
      "acpi": "gigabyte-z490",
      "macos": "26",
      "card_port": "\\_SB.PCI0.PEG1.PEGP"
    },
    {
      "name": "z490-report-refused",
      "about": "the same report with the Focusrite entry kept: OpCore Simplify refuses the report and the build must stop",
