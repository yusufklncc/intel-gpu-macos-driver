# build outputs
/build/
build-*/
*.o
*.a
*.dylib
*.kext/
*.bundle/
*.dSYM/
/nullmoth/translator/**/target/
*.log
*.err

# test binaries built next to their sources
/user/tests/**/*
!/user/tests/**/*.c
!/user/tests/**/*.h
!/user/tests/**/*.m
!/user/tests/**/*.metal
!/user/tests/**/*.sh
!/user/tests/**/*.ent
!/user/tests/**/*.md
!/user/tests/gate/rsh
!/user/tests/**/*.comp
!/user/tests/**/*.vert
!/user/tests/**/*.frag
!/user/tests/**/*.cl
!/user/tests/**/*.py
!/user/tests/**/*.html
!/user/tests/**/*.plist
!/user/tests/sycl/*.cpp
!/user/tests/plugin/refl/*
!/user/tests/plugin/link/*
!/user/tests/**/

# firmware is fetched (firmware/fetch.sh), never committed
/firmware/*.bin
/firmware/*.part
*.bin

# build dependencies fetched locally (MacKernelSDK, nullmoth release package)
/external/

# media, captures, Apple binaries and their disassembly
*.mp4
*.mov
*.mkv
*.webm
*.yuv
*.ppm
*.s
*.dis
*.ips
dsc/

# editor / OS
.DS_Store
*.swp
*~

# diagnostics reports (tools/report)
xe-report-XR-*
