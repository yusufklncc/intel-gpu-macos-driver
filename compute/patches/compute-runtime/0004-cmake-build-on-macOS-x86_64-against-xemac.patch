       else()
         set(L0_EXPORTS_FILE "${CMAKE_CURRENT_SOURCE_DIR}/core/source/dll/linux/ze_release.exports")
       endif()
-      set_property(TARGET ${TARGET_NAME_L0}
-                   APPEND_STRING PROPERTY LINK_FLAGS " -Wl,--version-script=${L0_EXPORTS_FILE}"
