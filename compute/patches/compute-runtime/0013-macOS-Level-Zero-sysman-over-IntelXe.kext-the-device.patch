+// SPDX-License-Identifier: MIT
+
+// The sysfs files of a Linux xe device that NEO reads (Level Zero sysman: frequency, power, energy, temperature), as a
+// small read-only tree answered from IntelXe.kext (xemac_pci_info, xemac_sensors). sys_calls_macos.cpp sends every
+// /sys/... and /proc/<pid>/fd/... path here; see sysfs_macos.cpp for the tree.
+
+#pragma once
+
+#include <cstddef>
+#include <dirent.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+
+namespace NEO {
+namespace MacSysfs {
+
+// The paths this answers: /sys/... and /proc/... (macOS has neither; anything not in the tree is ENOENT).
+bool isVirtualPath(const char *path);
+
+// The xemac fds the tree may ask the kext through (the render nodes NEO opened).
+void addDeviceFd(int fd);
+void removeDeviceFd(int fd);
+
+int open(const char *path, int flags);
+bool isVirtualFd(int fd);
+int close(int fd);
+ssize_t read(int fd, void *buf, size_t count);
+ssize_t pread(int fd, void *buf, size_t count, off_t offset);
+ssize_t pwrite(int fd, const void *buf, size_t count, off_t offset);
+
+int stat(const char *path, struct stat *st);
+int access(const char *path, int mode);
+int readlink(const char *path, char *buf, size_t bufsize);
+char *realpath(const char *path, char *resolved);
+
+DIR *opendir(const char *path);
+bool isVirtualDir(DIR *dir);
+struct dirent *readdir(DIR *dir);
+int closedir(DIR *dir);
+
+} // namespace MacSysfs
+} // namespace NEO
