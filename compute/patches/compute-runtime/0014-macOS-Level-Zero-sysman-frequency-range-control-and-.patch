+
+// perf_event_open of the emulated xe PMU (see the top): engine-active-ticks (2) and engine-total-ticks (3) of an engine
+// the kext reports; a group of them read through the leader.
+int perfEventOpen(uint32_t type, uint64_t config, int groupFd, uint64_t readFormat) {
+    const uint64_t event = config & 0xfff;
+    int result = -1;
+    {
+        std::lock_guard<std::mutex> l(state().lock);
+        ensureTree();
+        if (!state().pmuType || type != state().pmuType) {
+            errno = ENOENT;
+        } else if (event != 2 && event != 3) {
+            errno = ENOENT; // xe_pmu_event_init: an event this PMU does not have
+        } else if (groupFd >= 0 && !state().perf.count(groupFd)) {
+            errno = EBADF;
+        } else {
+            result = ::open("/dev/null", O_RDONLY | O_CLOEXEC);
+            if (result >= 0) {
+                State::PerfEvent e;
+                e.config = config;
+                e.readFormat = readFormat;
+                e.openNs = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+                state().perf[result] = e;
+                if (groupFd >= 0) {
+                    state().perf[groupFd].members.push_back(result);
+                }
+            }
+        }
+    }
+    if (tracing()) {
+        fprintf(stderr, "sysfs: perf_event_open config 0x%llx group %d -> %d\n", static_cast<unsigned long long>(config),
+                groupFd, result);
+    }
+    return result;
+}
+
+// The event's value in a sample: the counter of the engine its config names (class, instance, gt as
+// DRM_XE_DEVICE_QUERY_ENGINES lists them).
+static bool perfValue(const intelxe_sensors &s, uint64_t config, uint64_t &out) {
+    const uint32_t cls = (config >> 20) & 0xff, inst = (config >> 12) & 0xff, gt = (config >> 60) & 0xf;
+    if (!(s.valid & INTELXE_SENSORS_ENGINES)) {
+        return false;
+    }
+    for (uint32_t i = 0; i < s.engine_count && i < INTELXE_SENSORS_MAX_ENGINES; i++) {
+        const intelxe_sensors_engine &e = s.engines[i];
+        if (e.engine_class == cls && e.engine_instance == inst && e.gt_id == gt) {
+            out = (config & 0xfff) == 2 ? e.active_ticks : e.total_ticks;
+            return true;
+        }
+    }
+    return false;
+}
+
+// perf's read of an event: PERF_FORMAT_GROUP {nr, [time_enabled], value...}, else {value, [time_enabled]}
+// (PERF_FORMAT_TOTAL_TIME_ENABLED = 1, PERF_FORMAT_GROUP = 8; no others are asked for). One sample for the group.
+static ssize_t perfRead(int fd, void *buf, size_t count) {
+    intelxe_sensors s;
+    const bool have = sample(s);
+    std::vector<uint64_t> out;
+    {
+        std::lock_guard<std::mutex> l(state().lock);
+        auto it = state().perf.find(fd);
+        if (it == state().perf.end()) {
+            errno = EBADF;
+            return -1;
+        }
+        const uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+        auto value = [&](State::PerfEvent &e) {
+            uint64_t v = 0;
+            if (have && perfValue(s, e.config, v) && v >= e.last) {
+                e.last = v; // a counter only grows; an engine not in this sample keeps its last count
+            }
+            return e.last;
+        };
+        State::PerfEvent &lead = it->second;
+        const bool group = lead.readFormat & 8, timeEnabled = lead.readFormat & 1;
+        if (group) {
+            out.push_back(1 + lead.members.size());
+            if (timeEnabled) {
+                out.push_back(now - lead.openNs);
+            }
+            out.push_back(value(lead));
+            for (int m : lead.members) {
+                auto mi = state().perf.find(m);
+                out.push_back(mi == state().perf.end() ? 0 : value(mi->second));
+            }
+        } else {
+            out.push_back(value(lead));
+            if (timeEnabled) {
+                out.push_back(now - lead.openNs);
+            }
+        }
+    }
+    const size_t bytes = out.size() * sizeof(uint64_t);
+    if (count < bytes) {
+        errno = ENOSPC; // perf: the buffer is too small for the group
