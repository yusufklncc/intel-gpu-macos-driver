+      set_property(TARGET ${TARGET_NAME_L0} APPEND_STRING PROPERTY LINK_FLAGS " -Wl,-Bsymbolic")
     endif()
-    set_property(TARGET ${TARGET_NAME_L0} APPEND_STRING PROPERTY LINK_FLAGS " -Wl,-Bsymbolic")
   endif()
 
   create_source_tree(${TARGET_NAME_L0} ${L0_ROOT_DIR}/..)
