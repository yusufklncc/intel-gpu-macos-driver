      "macos": "15",
      "card_port": "\\_SB.PC00.PEG1.PEGP"
    },
    {
      "name": "z790-b580-igpu",
      "about": "the test machine with its UHD 770 left on in the firmware: macOS has no driver for it",
      "report": {
        "file": "z790-b580/Report.json",
        "replace": {
          "GPU": {
            "Intel(R) Arc(TM) B580 Graphics": {
              "Manufacturer": "Intel",
              "Codename": "Battlemage",
              "Device ID": "8086-E20B",
              "Device Type": "Discrete GPU",
              "PCI Path": "PciRoot(0x0)/Pci(0x1,0x0)/Pci(0x0,0x0)/Pci(0x1,0x0)/Pci(0x0,0x0)",
              "Resizable BAR": "Enabled"
            },
            "Intel(R) UHD Graphics 770": {
              "Manufacturer": "Intel",
              "Codename": "Raptor Lake-S",
              "Device ID": "8086-A780",
              "Device Type": "Integrated GPU",
              "PCI Path": "PciRoot(0x0)/Pci(0x2,0x0)",
              "ACPI Path": "\\_SB.PC00.GFX0"
            }
          }
        }
      },
      "acpi": "asus-b660",
      "macos": "26",
      "card_port": "\\_SB.PC00.PEG1.PEGP"
    },
    {
      "name": "z790-b580-ax210",
      "about": "the test machine with an Intel AX210 instead of its BE202: OpCore Simplify supports it and asks which Intel Wi-Fi kext to use",
