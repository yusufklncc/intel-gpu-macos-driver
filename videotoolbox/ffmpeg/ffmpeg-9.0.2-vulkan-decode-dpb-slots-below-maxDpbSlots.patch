+/* The DPB slot of a reference (0xff if it has none: not a reference) */
+static int vk_hevc_slot(const HEVCFrame *f)
+{
+    const HEVCVulkanDecodePicture *p = f->hwaccel_picture_private;
+    return p && p->slot_set ? p->slot : 0xff;
+}
+
+static int vk_hevc_assign_slots(AVCodecContext *avctx, HEVCLayerContext *l,
+                                HEVCFrame *pic)
+{
+    FFVulkanDecodeContext *dec = avctx->internal->hwaccel_priv_data;
+    const unsigned max_slots = dec->shared_ctx->caps.maxDpbSlots;
+    HEVCVulkanDecodePicture *hp = pic->hwaccel_picture_private;
+    uint64_t used = 0;
+
+    for (int pass = 0; pass < 2; pass++) {
+        for (int i = 0; i < FF_ARRAY_ELEMS(l->DPB); i++) {
+            HEVCFrame *ref = &l->DPB[i];
+            HEVCVulkanDecodePicture *rp = ref->hwaccel_picture_private;
+            if (ref == pic || !rp ||
+                !(ref->flags & (HEVC_FRAME_FLAG_SHORT_REF | HEVC_FRAME_FLAG_LONG_REF)))
+                continue;
+            if (pass == 0) {
+                /* the slots the references hold (one each) */
+                if (rp->slot_set && rp->slot < max_slots &&
+                    !(used & (UINT64_C(1) << rp->slot)))
+                    used |= UINT64_C(1) << rp->slot;
+                else
+                    rp->slot_set = 0;
+            } else if (!rp->slot_set) {
+                /* a reference never decoded here: any free slot */
+                int s = ff_vk_decode_free_dpb_slot(used, max_slots);
+                if (s < 0)
+                    goto full;
+                rp->slot = s;
+                rp->slot_set = 1;
+                used |= UINT64_C(1) << s;
+            }
+        }
+    }
 
+    hp->slot = ff_vk_decode_free_dpb_slot(used, max_slots);
+    if (hp->slot < 0)
+        goto full;
+    hp->slot_set = 1;
     return 0;
+
+full:
+    av_log(avctx, AV_LOG_ERROR, "No free DPB slot: the references hold all %u\n",
+           max_slots);
+    return AVERROR_INVALIDDATA;
 }
 
