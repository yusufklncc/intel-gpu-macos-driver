Date: Thu, 12 Nov 2026 15:41:12 +0300
Subject: [PATCH 6/9] xe: run without long-running VMs; allow a small BAR on
 macOS

- IoctlHelperXe created every VM with DRM_XE_VM_CREATE_FLAG_LR_MODE.
  A kernel that implements the xe uAPI without long-running mode
  (IntelXe.kext: no preempt fences yet) refuses it, and device creation
  failed. The flag is now probed once with a scratch VM; without it NEO
  runs in dma-fence mode VMs: the same exec and bind ioctls with user
  fences, but a job is subject to the kernel's job timeout.
- isSmallBarConfigAllowed() is true on macOS: the B580's CPU-visible
  window is 1 GB of its 12 GB there, and the kext maps a VRAM BO into the
  window when it is mapped and moves it to system memory when it cannot
  enter (as xe's fault handler does). Linux NEO refuses such a device on
  xe ("Resizable BAR not detected").

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../os_interface/linux/xe/ioctl_helper_xe.cpp | 21 ++++++++++++++++++-
 .../os_interface/linux/xe/ioctl_helper_xe.h   |  9 ++++++++
 2 files changed, 29 insertions(+), 1 deletion(-)

diff --git a/shared/source/os_interface/linux/xe/ioctl_helper_xe.cpp b/shared/source/os_interface/linux/xe/ioctl_helper_xe.cpp
index e0de61e570..efb3306677 100644
--- a/shared/source/os_interface/linux/xe/ioctl_helper_xe.cpp
+++ b/shared/source/os_interface/linux/xe/ioctl_helper_xe.cpp
@@ -1331,9 +1331,28 @@ void IoctlHelperXe::checkNoVmOvercommitFlag() {
     }
 }
 
+// A kernel that implements the xe uAPI without long-running VMs (IntelXe.kext on macOS: no preempt fences yet) refuses
+// DRM_XE_VM_CREATE_FLAG_LR_MODE. NEO then runs in dma-fence mode VMs: the same exec and bind ioctls with user fences,
+// but a job is subject to the kernel's job timeout. Probed once with a scratch VM.
+bool IoctlHelperXe::isLongRunningVmSupported() {
+    if (longRunningVmSupport < 0) {
+        struct drm_xe_vm_create vmCreate = {};
+        vmCreate.flags = DRM_XE_VM_CREATE_FLAG_LR_MODE;
+        longRunningVmSupport = 0;
+        if (IoctlHelper::ioctl(DrmIoctl::gemVmCreate, &vmCreate) == 0) {
+            struct drm_xe_vm_destroy vmDestroy = {};
+            vmDestroy.vm_id = vmCreate.vm_id;
+            IoctlHelper::ioctl(DrmIoctl::gemVmDestroy, &vmDestroy);
+            longRunningVmSupport = 1;
+        }
+        XELOG(" -> IoctlHelperXe::%s %d\n", NEO_FUNCTION_NAME, longRunningVmSupport);
+    }
+    return longRunningVmSupport == 1;
+}
+
 uint32_t IoctlHelperXe::getFlagsForVmCreate(bool disableScratch, bool enablePageFault, bool useVmBind) {
     XELOG(" -> IoctlHelperXe::%s %d,%d,%d\n", NEO_FUNCTION_NAME, disableScratch, enablePageFault, useVmBind);
-    uint32_t flags = DRM_XE_VM_CREATE_FLAG_LR_MODE;
+    uint32_t flags = isLongRunningVmSupported() ? DRM_XE_VM_CREATE_FLAG_LR_MODE : 0u;
     bool debuggingEnabled = drm.getRootDeviceEnvironment().executionEnvironment.isDebuggingEnabled();
     if (enablePageFault || debuggingEnabled) {
         flags |= DRM_XE_VM_CREATE_FLAG_FAULT_MODE;
