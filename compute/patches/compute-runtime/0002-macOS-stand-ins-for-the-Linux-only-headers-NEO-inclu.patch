diff --git a/shared/source/os_interface/macos/include/link.h b/shared/source/os_interface/macos/include/link.h
new file mode 100644
index 0000000000..d343c4c517
--- /dev/null
+++ b/shared/source/os_interface/macos/include/link.h
@@ -0,0 +1,20 @@
+// SPDX-License-Identifier: MIT
+
+// macOS stand-in for <link.h>, for the one use NEO makes of it: dlinfo(handle, RTLD_DI_LINKMAP) to read the path of a
+// loaded library (OsLibrary::getFullPath) or walk the loaded libraries (isLibraryLoaded). SysCalls::dlinfo on macOS
+// builds the list from dyld's image table (sys_calls_macos.cpp).
+#pragma once
+#include <dlfcn.h>
+#include <stdint.h>
+
+struct link_map {
+    uintptr_t l_addr;
+    char *l_name;
+    void *l_ld;
+    struct link_map *l_next;
+    struct link_map *l_prev;
+};
+
+#ifndef RTLD_DI_LINKMAP
+#define RTLD_DI_LINKMAP 2
+#endif
diff --git a/shared/source/os_interface/macos/include/linux/bits.h b/shared/source/os_interface/macos/include/linux/bits.h
new file mode 100644
index 0000000000..58e0ac834a
--- /dev/null
+++ b/shared/source/os_interface/macos/include/linux/bits.h
@@ -0,0 +1,9 @@
+// SPDX-License-Identifier: MIT
+
+// macOS stand-in for <linux/bits.h> (include/uapi/linux/bits.h), for drm_mode.h.
+#pragma once
+#ifndef _LINUX_BITS_H
+#define _LINUX_BITS_H
+#define __GENMASK(h, l) (((~0UL) - (1UL << (l)) + 1) & (~0UL >> (64 - 1 - (h))))
+#define __GENMASK_ULL(h, l) (((~0ULL) - (1ULL << (l)) + 1) & (~0ULL >> (64 - 1 - (h))))
+#endif
diff --git a/shared/source/os_interface/macos/include/linux/const.h b/shared/source/os_interface/macos/include/linux/const.h
new file mode 100644
index 0000000000..b651264f05
--- /dev/null
+++ b/shared/source/os_interface/macos/include/linux/const.h
@@ -0,0 +1,13 @@
+// SPDX-License-Identifier: MIT
+
+// macOS stand-in for <linux/const.h> (include/uapi/linux/const.h), for drm_mode.h.
+#pragma once
+#define _AC(X, Y) (X##Y)
+#define _UL(x) (_AC(x, UL))
+#define _ULL(x) (_AC(x, ULL))
+#define _BITUL(x) (_UL(1) << (x))
+#define _BITULL(x) (_ULL(1) << (x))
+#define __ALIGN_KERNEL(x, a) __ALIGN_KERNEL_MASK(x, (__typeof__(x))(a)-1)
+#define __ALIGN_KERNEL_MASK(x, mask) (((x) + (mask)) & ~(mask))
+#define __KERNEL_DIV_ROUND_UP(n, d) (((n) + (d)-1) / (d))
+#define __KERNEL_DIV_ROUND_CLOSEST(x, divisor) ((x) > 0 ? ((x) + ((divisor) / 2)) / (divisor) : ((x) - ((divisor) / 2)) / (divisor))
diff --git a/shared/source/os_interface/macos/include/linux/limits.h b/shared/source/os_interface/macos/include/linux/limits.h
new file mode 100644
