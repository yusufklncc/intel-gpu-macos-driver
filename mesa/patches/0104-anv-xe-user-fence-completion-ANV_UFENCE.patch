+/*
+ * User-fence completion on Xe (ANV_UFENCE=1, off by default).
+ *
+ * A CPU wait on a syncobj sleeps in the kernel until the job's interrupt has
+ * been handled, the syncobj signaled and the waiting thread scheduled again.
+ * For a short job that wake-up path costs more than the job itself. Intel's
+ * compute runtime avoids it the same way on Xe: every exec carries a
+ * DRM_XE_SYNC_TYPE_USER_FENCE whose address is the "completion fence" in its
+ * command stream receiver's tag allocation (system memory) and whose value
+ * is the submission's task count (DrmCommandStreamReceiver::flushInternal,
+ * IoctlHelperXe::execBuffer). Its waits read that memory first and poll it
+ * briefly (CommandStreamReceiver::baseWaitFunction, WaitUtils::waitFunction:
+ * a pause, or umwait, per poll) before they ask the kernel
+ * (Drm::waitOnUserFencesImpl -> DRM_IOCTL_XE_WAIT_USER_FENCE).
+ *
+ * Here each queue gets a 64-bit user fence in a CPU-mapped, cached-coherent
+ * system-memory BO and a submission sequence number. Every exec with a batch
+ * carries {user fence, ++seqno}; the kernel's ring writes the value after the
+ * job's end-of-job cache flush (xe_ring_ops.c emit_store_imm_ppgtt_posted),
+ * so by the time the CPU reads it everything the job wrote is visible, as it
+ * is when the syncobj signals: the same ring writes the seqno that signals
+ * the syncobj right after. Jobs of one exec queue run in order, so
+ * *fence >= n means submission n is done.
+ *
+ * The syncobjs stay the only synchronization primitive the kernel and other
+ * processes see. sync_syncobj_type is the DRM syncobj type with a few more
+ * bytes per sync: records of the submissions that signal it (fence address
+ * and seqno; for a timeline the last few, with their points). CPU waits that
+ * those records satisfy return without a system call; otherwise, while every
+ * wait left has a record, they poll the records for up to ANV_UFENCE_SPIN_US
+ * (default 100) and then call the plain DRM syncobj wait for whatever is
+ * left, with the caller's timeout. Anything that changes a payload behind the
+ * records (reset, import, move, a CPU signal, a payload copy) drops them
+ * first, so a record can only be stale in the "unknown, ask the kernel"
+ * direction. Execs without a batch (a submission with no command buffer that
+ * only signals) carry no user fence and leave no record. Exports, waits for
+ * submission (WAIT_PENDING), counter queries (vkGetSemaphoreCounterValue)
+ * and timeouts all stay on the syncobj path.
+ *
+ * In IntelXe.kext a job with a user fence leaves direct submission (the armed
+ * ring slot was written without the fence's store), so with
+ * debug.intelxe.direct=1 this trades the direct start for the faster wake-up.
+ *
+ * Sequence numbers are 64-bit and compared as a signed difference, so even a
+ * wrap (centuries away at one submission per microsecond) orders correctly.
+ * A job that never completes (hang, ban) never writes its value; its waiters
+ * fall through to the syncobj wait, which reports what the kernel reports.
+ */
+
+#include "xe/anv_ufence.h"
+
+#include "anv_private.h"
+
+#include "drm-uapi/xe_drm.h"
+#include "util/os_time.h"
+#include "util/u_debug.h"
+#include "vk_drm_syncobj.h"
+
+/* Timelines keep the last few submissions that signal them: a client waits
+ * for an older point while newer ones are in flight (DXVK's and
+ * vkd3d-proton's fence threads wait for their submissions in order).
+ */
+#define ANV_UFENCE_HISTORY 8
+
+struct anv_ufence_point {
+   const uint64_t *ufence;
+   uint64_t seqno;
+   uint64_t point; /* timelines: the value that submission signals */
+};
+
+struct anv_ufence_sync {
+   struct vk_drm_syncobj base;
+
+   /* Guarded by anv_device::ufence_mutex. A binary sync uses rec[0] only. */
+   uint32_t count;
+   uint32_t next;
+   struct anv_ufence_point rec[ANV_UFENCE_HISTORY];
+};
+
+static inline struct anv_device *
+to_anv_device(struct vk_device *vk_device)
+{
+   return container_of(vk_device, struct anv_device, vk);
+}
+
+static inline const struct vk_sync_type *
+drm_type(struct vk_device *vk_device)
+{
+   return &to_anv_device(vk_device)->physical->sync_drm_syncobj_type;
+}
+
+static inline struct anv_ufence_sync *
+to_ufence_sync(struct vk_device *vk_device, struct vk_sync *sync)
+{
+   if (sync->type != &to_anv_device(vk_device)->physical->sync_syncobj_type)
+      return NULL;
+   return container_of(sync, struct anv_ufence_sync, base.base);
+}
+
+static inline bool
+ufence_passed(const uint64_t *ufence, uint64_t seqno)
+{
+   /* Acquire: nothing the caller reads after a passed fence may be read
+    * before it (on x86 a compiler barrier; the GPU's writes reached memory
+    * before the fence value did).
+    */
+   const uint64_t v = __atomic_load_n(ufence, __ATOMIC_ACQUIRE);
+   return (int64_t)(v - seqno) >= 0;
+}
+
+static inline void
+cpu_relax(void)
+{
+#if defined(__x86_64__) || defined(__i386__)
+   __builtin_ia32_pause();
+#elif defined(__aarch64__)
+   __asm__ volatile("yield");
+#endif
+}
+
+static void
+forget(struct vk_device *vk_device, struct vk_sync *sync)
+{
+   struct anv_ufence_sync *s = to_ufence_sync(vk_device, sync);
+   if (s == NULL)
+      return;
+
+   struct anv_device *device = to_anv_device(vk_device);
+   simple_mtx_lock(&device->ufence_mutex);
+   s->count = 0;
+   s->next = 0;
+   simple_mtx_unlock(&device->ufence_mutex);
+}
+
+/* A CPU signal: a binary payload is replaced; on a timeline, the points up
+ * to the value are reached, and the kernel now answers for them at once.
+ * Guarded by anv_device::ufence_mutex.
+ */
+static void
+forget_signaled(struct anv_ufence_sync *s, bool timeline, uint64_t value)
+{
+   if (!timeline) {
+      s->count = 0;
+      s->next = 0;
+      return;
+   }
+   for (uint32_t i = 0; i < s->count; i++) {
+      if (s->rec[i].point <= value)
+         s->rec[i].ufence = NULL;
+   }
+}
+
+static VkResult
+anv_ufence_sync_signal(struct vk_device *vk_device, struct vk_sync *sync,
+                       uint64_t value)
+{
+   struct anv_ufence_sync *s = to_ufence_sync(vk_device, sync);
+   if (s != NULL) {
+      struct anv_device *device = to_anv_device(vk_device);
+      simple_mtx_lock(&device->ufence_mutex);
+      forget_signaled(s, sync->flags & VK_SYNC_IS_TIMELINE, value);
+      simple_mtx_unlock(&device->ufence_mutex);
+   }
+   return drm_type(vk_device)->signal(vk_device, sync, value);
+}
+
+static VkResult
+anv_ufence_sync_signal_many(struct vk_device *vk_device,
+                            uint32_t signal_count,
+                            const struct vk_sync_signal *signals)
+{
+   struct anv_device *device = to_anv_device(vk_device);
+   simple_mtx_lock(&device->ufence_mutex);
+   for (uint32_t i = 0; i < signal_count; i++) {
+      struct anv_ufence_sync *s = to_ufence_sync(vk_device, signals[i].sync);
+      if (s != NULL)
+         forget_signaled(s, signals[i].sync->flags & VK_SYNC_IS_TIMELINE,
+                         signals[i].signal_value);
+   }
+   simple_mtx_unlock(&device->ufence_mutex);
+   return drm_type(vk_device)->signal_many(vk_device, signal_count, signals);
+}
+
+static VkResult
+anv_ufence_sync_reset(struct vk_device *vk_device, struct vk_sync *sync)
+{
+   forget(vk_device, sync);
+   return drm_type(vk_device)->reset(vk_device, sync);
+}
+
+static VkResult
+anv_ufence_sync_reset_many(struct vk_device *vk_device, uint32_t sync_count,
+                           struct vk_sync *const *syncs)
+{
+   for (uint32_t i = 0; i < sync_count; i++)
+      forget(vk_device, syncs[i]);
+   return drm_type(vk_device)->reset_many(vk_device, sync_count, syncs);
+}
+
+static VkResult
+anv_ufence_sync_move(struct vk_device *vk_device, struct vk_sync *dst,
+                     struct vk_sync *src)
+{
+   forget(vk_device, dst);
+   forget(vk_device, src);
+   return drm_type(vk_device)->move(vk_device, dst, src);
+}
+
+static VkResult
+anv_ufence_sync_import_opaque_fd(struct vk_device *vk_device,
+                                 struct vk_sync *sync, int fd)
+{
+   forget(vk_device, sync);
+   return drm_type(vk_device)->import_opaque_fd(vk_device, sync, fd);
+}
+
+static VkResult
+anv_ufence_sync_import_sync_file(struct vk_device *vk_device,
+                                 struct vk_sync *sync, int sync_file)
+{
+   forget(vk_device, sync);
+   return drm_type(vk_device)->import_sync_file(vk_device, sync, sync_file);
+}
+
+/* vk_device::copy_sync_payloads replaces the signal syncs' payloads behind
+ * the sync type's back (DRM_IOCTL_SYNCOBJ_TRANSFER).
+ */
+static VkResult
+anv_ufence_copy_sync_payloads(struct vk_device *vk_device,
+                              uint32_t wait_count,
+                              const struct vk_sync_wait *waits,
+                              uint32_t signal_count,
+                              const struct vk_sync_signal *signals)
+{
+   for (uint32_t i = 0; i < signal_count; i++)
+      forget(vk_device, signals[i].sync);
+   return vk_drm_syncobj_copy_payloads(vk_device, wait_count, waits,
+                                       signal_count, signals);
+}
+
+struct ufence_wait {
+   const uint64_t *ufence; /* NULL: no usable record, ask the kernel */
+   uint64_t seqno;
+};
+
+static VkResult
+anv_ufence_sync_wait_many(struct vk_device *vk_device,
+                          uint32_t wait_count,
+                          const struct vk_sync_wait *waits,
+                          enum vk_sync_wait_flags wait_flags,
+                          uint64_t abs_timeout_ns)
+{
+   struct anv_device *device = to_anv_device(vk_device);
+   const struct vk_sync_type *drm = drm_type(vk_device);
+
+   /* Waiting for submission is the kernel's business. */
+   if (wait_flags & VK_SYNC_WAIT_PENDING)
+      return drm->wait_many(vk_device, wait_count, waits, wait_flags,
+                            abs_timeout_ns);
+
+   const bool wait_any = wait_flags & VK_SYNC_WAIT_ANY;
+   VkResult result = VK_SUCCESS;
+
+   STACK_ARRAY(struct vk_sync_wait, left, wait_count);
+   STACK_ARRAY(struct ufence_wait, uf, wait_count);
+   uint32_t n = 0;
+
+   simple_mtx_lock(&device->ufence_mutex);
+   for (uint32_t i = 0; i < wait_count; i++) {
+      const bool timeline = waits[i].sync->flags & VK_SYNC_IS_TIMELINE;
+      const uint64_t value = waits[i].wait_value;
+      bool satisfied = timeline && value == 0; /* as vk_drm_syncobj_wait_many */
+
+      /* The submission that signals exactly this point (binary: the last
+       * one), to poll. A later point that has passed satisfies the wait as
+       * well; one that has not says nothing about this point, which an
+       * unrecorded signal (an exec without a batch, another process) may
+       * have reached already, so it is no reason to poll.
+       */
+      struct ufence_wait w = { NULL, 0 };
+      struct anv_ufence_sync *s = to_ufence_sync(vk_device, waits[i].sync);
+      for (uint32_t r = 0; s != NULL && !satisfied && r < s->count; r++) {
+         const struct anv_ufence_point *p = &s->rec[r];
+         if (p->ufence == NULL)
+            continue;
+         if (!timeline || p->point == value) {
+            w.ufence = p->ufence;
+            w.seqno = p->seqno;
+         } else if (p->point > value && ufence_passed(p->ufence, p->seqno)) {
+            satisfied = true;
+         }
+      }
+
+      if (satisfied) {
+         if (wait_any) {
+            n = 0;
+            break;
+         }
+         continue;
+      }
+
+      left[n] = waits[i];
+      uf[n] = w;
+      n++;
+   }
+   simple_mtx_unlock(&device->ufence_mutex);
+
+   /* An ANY wait with one wait satisfied (n was cleared), or an ALL wait
+    * with all of them satisfied.
+    */
+   if (n == 0)
+      goto done;
+
+   const uint64_t start = os_time_get_nano();
+   const uint64_t spin_end =
+      MIN2(abs_timeout_ns, start + p_atomic_read(&device->ufence_spin_ns));
+   for (;;) {
+      bool all_recorded = true;
+      uint32_t k = 0;
+      for (uint32_t i = 0; i < n; i++) {
+         if (uf[i].ufence != NULL && ufence_passed(uf[i].ufence, uf[i].seqno)) {
+            if (wait_any)
+               goto done;
+            continue;
+         }
+         all_recorded &= uf[i].ufence != NULL;
+         left[k] = left[i];
+         uf[k] = uf[i];
+         k++;
+      }
+      n = k;
+      if (n == 0)
+         goto done;
+
+      /* Polling only pays while every remaining wait has a fence to poll:
+       * one without would be missed until the poll ends.
+       */
+      if (!all_recorded || os_time_get_nano() >= spin_end)
+         break;
+      cpu_relax();
+   }
+
+   result = drm->wait_many(vk_device, n, left, wait_flags, abs_timeout_ns);
+
+   /* The syncobj of a job signals after its user fence is written (the
+    * ring stores the fence, then the seqno, then raises the interrupt). An
+    * ALL wait that the kernel satisfied while a polled fence is still behind
+    * means the fence is not being written: a kernel that ignores an exec's
+    * user fence, or jobs cancelled by a ban. Polling would then only add its
+    * whole budget to every wait, so after a few such waits it stops.
+    */
+   if (result == VK_SUCCESS && !wait_any &&
+       p_atomic_read(&device->ufence_spin_ns) != 0) {
+      for (uint32_t i = 0; i < n; i++) {
+         if (uf[i].ufence == NULL || ufence_passed(uf[i].ufence, uf[i].seqno))
+            continue;
+         if (p_atomic_inc_return(&device->ufence_misses) == 16) {
+            p_atomic_set(&device->ufence_spin_ns, 0);
+            mesa_logw("anv: user fences behind their syncobjs, no more "
+                      "polling (ANV_UFENCE)");
+         }
+         break;
+      }
+   }
+
+done:
+   STACK_ARRAY_FINISH(left);
+   STACK_ARRAY_FINISH(uf);
+   return result;
+}
+
+void
+anv_xe_ufence_init_physical_device(struct anv_physical_device *pdevice)
+{
+   pdevice->has_ufence = false;
+   if (!debug_get_bool_option("ANV_UFENCE", false))
+      return;
+
+   const struct vk_sync_type *drm = &pdevice->sync_syncobj_type;
+   if (!vk_sync_type_is_drm_syncobj(drm) || drm->wait_many == NULL ||
+       drm->signal_many == NULL || drm->reset_many == NULL ||
+       drm->move == NULL || drm->import_opaque_fd == NULL ||
+       drm->import_sync_file == NULL)
+      return;
+
+   pdevice->sync_drm_syncobj_type = *drm;
+
+   /* Same functions and features, so vk_sync_as_drm_syncobj() (which keys on
+    * .finish) and every export keep working on these syncs.
+    */
+   struct vk_sync_type *t = &pdevice->sync_syncobj_type;
+   t->size = sizeof(struct anv_ufence_sync);
+   t->signal = anv_ufence_sync_signal;
+   t->signal_many = anv_ufence_sync_signal_many;
+   t->reset = anv_ufence_sync_reset;
+   t->reset_many = anv_ufence_sync_reset_many;
+   t->move = anv_ufence_sync_move;
+   t->import_opaque_fd = anv_ufence_sync_import_opaque_fd;
+   t->import_sync_file = anv_ufence_sync_import_sync_file;
+   t->wait_many = anv_ufence_sync_wait_many;
+
+   pdevice->has_ufence = true;
+}
+
+void
+anv_xe_ufence_init_device(struct anv_device *device)
+{
+   if (!device->physical->has_ufence)
+      return;
+
+   simple_mtx_init(&device->ufence_mutex, mtx_plain);
+   device->ufence_spin_ns =
+      debug_get_num_option("ANV_UFENCE_SPIN_US", 100) * 1000ull;
+   device->vk.copy_sync_payloads = anv_ufence_copy_sync_payloads;
+
+   mesa_logi("anv: user-fence completion on, CPU waits poll up to %" PRIu64
+             " us (ANV_UFENCE, ANV_UFENCE_SPIN_US)",
+             device->ufence_spin_ns / 1000);
+}
+
+void
+anv_xe_ufence_finish_device(struct anv_device *device)
+{
+   if (device->physical->has_ufence)
+      simple_mtx_destroy(&device->ufence_mutex);
+}
+
+VkResult
+anv_xe_ufence_init_queue(struct anv_queue *queue)
+{
+   struct anv_device *device = queue->device;
+   if (!device->physical->has_ufence)
+      return VK_SUCCESS;
+
+   /* System memory, cached and coherent: the GPU's write snoops the CPU's
+    * caches, so a poll reads a cached line until that write lands, as the
+    * compute runtime's tag allocation in system memory does. Its own page:
+    * nothing else shares the line.
+    */
+   VkResult result =
+      anv_device_alloc_bo(device, "ufence", 4096,
+                          ANV_BO_ALLOC_MAPPED |
+                          ANV_BO_ALLOC_HOST_CACHED_COHERENT |
+                          ANV_BO_ALLOC_NO_LOCAL_MEM |
+                          ANV_BO_ALLOC_INTERNAL,
+                          0 /* explicit_address */,
+                          &queue->ufence_bo);
+   if (result != VK_SUCCESS)
+      return result;
+
+   ANV_DMR_BO_ALLOC(&device->vk.base, queue->ufence_bo, result);
+   memset(queue->ufence_bo->map, 0, 64);
+   queue->ufence_map = queue->ufence_bo->map;
+   queue->ufence_seqno = 0;
+   return VK_SUCCESS;
+}
+
+void
+anv_xe_ufence_finish_queue(struct anv_queue *queue)
+{
+   if (queue->ufence_bo == NULL)
+      return;
+
+   ANV_DMR_BO_FREE(&queue->device->vk.base, queue->ufence_bo);
+   anv_device_release_bo(queue->device, queue->ufence_bo);
+   queue->ufence_bo = NULL;
+   queue->ufence_map = NULL;
+}
+
+/* The user fence for the next exec of this queue, which must have a batch
+ * (xe writes an exec's user fence from the job's ring commands; an exec
+ * without a batch has no job). Called under the queue's submission lock;
+ * the caller records the signals with anv_xe_ufence_record() once the exec
+ * has succeeded.
+ */
+bool
+anv_xe_ufence_next(struct anv_queue *queue, struct drm_xe_sync *sync)
+{
+   if (queue->ufence_bo == NULL)
+      return false;
+
+   *sync = (struct drm_xe_sync) {
+      .type = DRM_XE_SYNC_TYPE_USER_FENCE,
+      .flags = DRM_XE_SYNC_FLAG_SIGNAL,
+      .addr = intel_48b_address(queue->ufence_bo->offset),
+      .timeline_value = queue->ufence_seqno + 1,
+   };
+   return true;
+}
+
+void
+anv_xe_ufence_record(struct anv_queue *queue,
+                     uint32_t signal_count,
+                     const struct vk_sync_signal *signals)
+{
+   struct anv_device *device = queue->device;
+   const uint64_t seqno = ++queue->ufence_seqno;
+
+   simple_mtx_lock(&device->ufence_mutex);
+   for (uint32_t i = 0; i < signal_count; i++) {
+      struct anv_ufence_sync *s = to_ufence_sync(&device->vk, signals[i].sync);
+      if (s == NULL)
+         continue;
+
+      const struct anv_ufence_point p = {
+         .ufence = queue->ufence_map,
+         .seqno = seqno,
+         .point = signals[i].signal_value,
+      };
+      if (!(signals[i].sync->flags & VK_SYNC_IS_TIMELINE)) {
+         s->rec[0] = p;
+         s->count = 1;
+         continue;
+      }
+
+      /* The oldest entry makes room. */
+      s->rec[s->next] = p;
+      s->next = (s->next + 1) % ANV_UFENCE_HISTORY;
+      s->count = MAX2(s->count, s->next == 0 ? ANV_UFENCE_HISTORY : s->next);
+   }
+   simple_mtx_unlock(&device->ufence_mutex);
+}
