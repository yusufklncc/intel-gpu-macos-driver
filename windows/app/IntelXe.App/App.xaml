<Application
    x:Class="IntelXe.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- the state colours of the macOS app's cards and rows (green, orange, red, grey), with enough contrast on
                 each theme -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="StatusGoodColor">#1E8E3E</Color>
                    <Color x:Key="StatusWarningColor">#C25100</Color>
                    <Color x:Key="StatusBadColor">#D70015</Color>
                    <Color x:Key="StatusNeutralColor">#6E6E73</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="StatusGoodColor">#30D158</Color>
                    <Color x:Key="StatusWarningColor">#FF9F0A</Color>
                    <Color x:Key="StatusBadColor">#FF453A</Color>
                    <Color x:Key="StatusNeutralColor">#98989D</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- the accent of IntelXe Manager on macOS: the system blue it uses (#007AFF light, #0A84FF dark), and the
                 lighter and darker steps WinUI derives its accent brushes from -->
            <Color x:Key="SystemAccentColor">#0A84FF</Color>
            <Color x:Key="SystemAccentColorLight1">#2B93FF</Color>
            <Color x:Key="SystemAccentColorLight2">#4DA3FF</Color>
            <Color x:Key="SystemAccentColorLight3">#80BDFF</Color>
            <Color x:Key="SystemAccentColorDark1">#007AFF</Color>
            <Color x:Key="SystemAccentColorDark2">#0062CC</Color>
            <Color x:Key="SystemAccentColorDark3">#004A99</Color>

            <!-- styles with theme resources, so that elements built in code follow the page's light or dark theme (a brush
                 looked up in code would keep the theme of the moment it was read) -->
            <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="SecondaryBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="SecondaryCaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="AccentIconStyle" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="SecondaryIconStyle" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,14,16,14" />
            </Style>
            <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="FontSize" Value="15" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
